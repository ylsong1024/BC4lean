import BC4lean.KasparovProductAlgebras

/-! # The actual countable product defect algebra and normalizer tests

The second algebra is generated by the actual connection square,
anticommutator, source commutators and group errors, together with their
genuine grading images. Its creation-local compactness is proved from the
connection laws and localized second-cycle defects. Separability follows
from separability of the source algebra and countability of the group;
it does not require separability of the ambient endomorphism algebra.
-/

noncomputable section
namespace BC4lean.KKTheory
open Filter TopologicalSpace
open scoped Topology CStarAlgebra

variable {Γ A B C E F : Type*} [Group Γ]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]
  [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul Bᵐᵒᵖ E] [CStarModule Bᵐᵒᵖ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [SMul Cᵐᵒᵖ F] [CStarModule Cᵐᵒᵖ F]
  [CompleteSpace E] [CompleteSpace F]
  {α : CStarAlgebraAction Γ A} {β : CStarAlgebraAction Γ B}
  {γ : CStarAlgebraAction Γ C}
  {δA : CStarGrading A} {δB : CStarGrading B} {δC : CStarGrading C}

variable (c : GradedKasparovCycle α β δA δB E) (d : GradedKasparovCycle β γ δB δC F)
  (G : AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
    (InteriorModuleTensor (E := E) d.representation))

def productSecondDefectGenerators : Set
    (AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
      (InteriorModuleTensor (E := E) d.representation)) :=
  (({G * G - 1} ∪
    {interiorModuleTensorOperator d.representation c.operator * G +
      G * interiorModuleTensorOperator d.representation c.operator}) ∪
    Set.range (fun a : A => G * gradedKasparovTensorRepresentation c d a -
      gradedKasparovTensorRepresentation c d (δA.automorphism a) * G)) ∪
    Set.range (fun g : Γ => (gradedKasparovTensorAction c d).conjugateOperator g G - G)

def productSecondDefectAlgebra : NonUnitalStarSubalgebra ℂ
    (AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
      (InteriorModuleTensor (E := E) d.representation)) :=
  closedNonUnitalStarAdjoin (productSecondDefectGenerators c d G ∪
    (gradedKasparovTensorGrading c d).conjugateOperator '' productSecondDefectGenerators c d G)

theorem productSecondDefectAlgebra_isClosed :
    IsClosed (productSecondDefectAlgebra c d G : Set
      (AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
        (InteriorModuleTensor (E := E) d.representation))) :=
  closedNonUnitalStarAdjoin_isClosed _

theorem productSecondDefectGenerators_mem {T} (hT : T ∈ productSecondDefectGenerators c d G) :
    T ∈ productSecondDefectAlgebra c d G :=
  subset_closedNonUnitalStarAdjoin _ (Or.inl hT)

/-- All of the actual unaveraged second generators are creation-locally
compact, proved from the four analytic connection laws. -/
theorem productSecondDefectGenerators_creationLocallyCompact
    (hdsa : IsSelfAdjoint d.operator)
    (hGsa : IsSelfAdjoint G) (hG : GradedKasparovConnection c d G) :
    ∀ T ∈ productSecondDefectGenerators c d G, IsCreationLocallyCompact d.representation T := by
  intro T hT
  rcases hT with ((hT | hT) | hT) | hT
  · have h : T = G * G - 1 := hT
    rw [h]
    exact hG.square_creation_locallyCompact hGsa hdsa
  · have h : T = interiorModuleTensorOperator d.representation c.operator * G +
        G * interiorModuleTensorOperator d.representation c.operator := hT
    rw [h]
    exact hG.first_anticommutator_creation_locallyCompact_of_selfadjoint_connection hGsa
  · obtain ⟨a, rfl⟩ := hT
    exact hG.source_commutator_creation_locallyCompact hGsa a
  · obtain ⟨g, rfl⟩ := hT
    exact hG.action_defect_creation_locallyCompact hGsa hdsa g

/-- The actual norm closure of the second defect algebra remains in the
genuine closed creation-local containing algebra. -/
theorem productSecondDefectAlgebra_creationLocallyCompact
    (hdsa : IsSelfAdjoint d.operator)
    (hGsa : IsSelfAdjoint G) (hG : GradedKasparovConnection c d G) :
    ∀ T ∈ productSecondDefectAlgebra c d G, IsCreationLocallyCompact d.representation T := by
  apply closedNonUnitalStarAdjoin_le _ (creationLocallyCompactAlgebra (E := E) d.representation)
    (creationLocallyCompactAlgebra_isClosed d.representation)
  intro T hT
  rcases hT with hT | hT
  · exact productSecondDefectGenerators_creationLocallyCompact c d G hdsa hGsa hG T hT
  · obtain ⟨S, hS, rfl⟩ := hT
    exact grading_preserves_creationLocallyCompactAlgebra d.representation
      c.grading d.grading d.representation_graded
        (productSecondDefectGenerators_creationLocallyCompact c d G hdsa hGsa hG S hS)

/-- Doubling the actual source generators by genuine grading conjugation
makes their closed star algebra exactly grading stable. -/
theorem grading_preserves_productSecondDefectAlgebra :
    ∀ T ∈ productSecondDefectAlgebra c d G,
      (gradedKasparovTensorGrading c d).conjugateOperator T ∈ productSecondDefectAlgebra c d G := by
  let J := gradedKasparovTensorGrading c d
  apply maps_closedNonUnitalStarAdjoin _ J.conjugateOperatorStarAlgEquiv
  intro T hT
  rcases hT with hT | hT
  · exact subset_closedNonUnitalStarAdjoin _ (Or.inr ⟨T, hT, rfl⟩)
  · obtain ⟨S, hS, rfl⟩ := hT
    change J.conjugateOperator (J.conjugateOperator S) ∈ _
    rw [J.conjugateOperator_involutive]
    exact productSecondDefectGenerators_mem c d G hS

/-- The genuine second defect algebra is norm separable in the usual
separable source and countable discrete group setting. -/
theorem productSecondDefectAlgebra_isSeparable [SeparableSpace A] [Countable Γ] :
    IsSeparable (productSecondDefectAlgebra c d G : Set
      (AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
        (InteriorModuleTensor (E := E) d.representation))) := by
  let ρ := gradedKasparovTensorRepresentation c d
  have hcomm : Continuous (fun a : A => G * ρ a - ρ (δA.automorphism a) * G) :=
    (continuous_const.mul (map_continuous ρ)).sub
      (((map_continuous ρ).comp (StarAlgEquiv.isometry δA.automorphism).continuous).mul continuous_const)
  have hgen : IsSeparable (productSecondDefectGenerators c d G) :=
    (((Set.finite_singleton (G * G - 1)).isSeparable.union
      (Set.finite_singleton
        (interiorModuleTensorOperator d.representation c.operator * G +
          G * interiorModuleTensorOperator d.representation c.operator)).isSeparable).union
      (isSeparable_range hcomm)).union
        (Set.countable_range (fun g : Γ => (gradedKasparovTensorAction c d).conjugateOperator g G - G)).isSeparable
  apply closedNonUnitalStarAdjoin_isSeparable
  exact hgen.union (hgen.image (StarAlgEquiv.isometry ((gradedKasparovTensorGrading c d).conjugateOperatorStarAlgEquiv)).continuous)

/-- Genuine separability constructs a countable two-sided AU for the
actual second defect algebra, without a global separability assumption. -/
theorem exists_productSecondDefectAlgebra_approximateUnit [SeparableSpace A] [Countable Γ] :
    ∃ q : ℕ → productSecondDefectAlgebra c d G,
      (∀ a, Tendsto (fun n => a * q n) atTop (𝓝 a)) ∧
        (∀ a, Tendsto (fun n => q n * a) atTop (𝓝 a)) := by
  let : IsClosed (productSecondDefectAlgebra c d G : Set
      (AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
        (InteriorModuleTensor (E := E) d.representation))) :=
    productSecondDefectAlgebra_isClosed c d G
  let : SeparableSpace (productSecondDefectAlgebra c d G) :=
    (productSecondDefectAlgebra_isSeparable c d G).separableSpace
  let : PartialOrder (productSecondDefectAlgebra c d G) := CStarAlgebra.spectralOrder _
  let : StarOrderedRing (productSecondDefectAlgebra c d G) := CStarAlgebra.spectralOrderedRing _
  obtain ⟨q, _, _, _, _, _, hleft, hright⟩ :=
    exists_separable_increasing_approximateUnit (J := productSecondDefectAlgebra c d G)
  exact ⟨q, hleft, hright⟩

/-- The concrete normalizer set contains precisely the first lift, the
actual frame connection and every source represented operator. -/
def productNormalizerTests : Set
    (AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
      (InteriorModuleTensor (E := E) d.representation)) :=
  ({interiorModuleTensorOperator d.representation c.operator} ∪ {G}) ∪
    Set.range (gradedKasparovTensorRepresentation c d)

theorem productNormalizerTests_isSeparable [SeparableSpace A] :
    IsSeparable (productNormalizerTests c d G) :=
  ((Set.finite_singleton (interiorModuleTensorOperator d.representation c.operator)).isSeparable.union
    (Set.finite_singleton G).isSeparable).union
    (isSeparable_range (map_continuous (gradedKasparovTensorRepresentation c d)))

theorem productNormalizerTests_normalize_firstProductAlgebra
    (hdsa : IsSelfAdjoint d.operator) (hGsa : IsSelfAdjoint G)
    (hG : GradedKasparovConnection c d G) :
    ∀ T ∈ productNormalizerTests c d G,
      ∀ a ∈ firstProductAlgebra d.representation d.operator,
        T * a - a * T ∈ firstProductAlgebra d.representation d.operator := by
  intro T hT
  rcases hT with (hT | hT) | hT
  · have h : T = interiorModuleTensorOperator d.representation c.operator := hT
    rw [h]
    exact tensorOperator_normalizes_firstProductAlgebra d.representation d.operator c.operator
  · have h : T = G := hT
    rw [h]
    exact hG.normalizes_firstProductAlgebra hGsa hdsa
  · obtain ⟨a, rfl⟩ := hT
    exact tensorOperator_normalizes_firstProductAlgebra d.representation d.operator (c.representation a)

/-- Every genuine cycle defect belongs to its explicitly constructed
technical algebra. This checks actual memberships, not product existence. -/
theorem actualKasparovProductTechnicalInputs :
    KasparovProductTechnicalInputs c d G (firstProductAlgebra d.representation d.operator)
      (productSecondDefectAlgebra c d G) (productNormalizerTests c d G) where
  first_mem := Or.inl (Or.inl rfl)
  connection_mem := Or.inl (Or.inr rfl)
  representation_mem a := Or.inr ⟨a, rfl⟩
  creation_square_mem x := by
    exact creationSandwich_one_mem_firstProductAlgebra d.representation d.operator x x
  first_square_mem a := by
    have h := tensorCompact_mem_firstProductAlgebra d.representation d.operator
      (c.square_mod_compact a)
    change interiorModuleTensorOperatorHom d.representation
      ((c.operator * c.operator - 1) * c.representation a) ∈ _ at h
    simpa only [map_mul, map_sub, map_one, interiorModuleTensorOperatorHom_apply,
      gradedKasparovTensorRepresentation_apply] using h
  first_commutator_mem a := by
    have h := tensorCompact_mem_firstProductAlgebra d.representation d.operator
      (c.commutator_compact a)
    change interiorModuleTensorOperatorHom d.representation
      (c.operator * c.representation a - c.representation (δA.automorphism a) * c.operator) ∈ _ at h
    simpa only [map_sub, map_mul, interiorModuleTensorOperatorHom_apply,
      gradedKasparovTensorRepresentation_apply] using h
  first_equivariance_mem g a := by
    change ((c.groupAction.interiorTensor d.groupAction
      (d.groupAction.representationEquivariant_of_conjugate d.representation_equivariant)).conjugateOperator g
        (interiorModuleTensorOperator d.representation c.operator) -
      interiorModuleTensorOperator d.representation c.operator) *
        gradedKasparovTensorRepresentation c d a ∈ firstProductAlgebra d.representation d.operator
    rw [EquivariantHilbertModule.interiorTensor_conjugateOperator]
    have h := tensorCompact_mem_firstProductAlgebra d.representation d.operator
      (c.equivariance_mod_compact g a)
    change interiorModuleTensorOperatorHom d.representation
      ((c.groupAction.conjugateOperator g c.operator - c.operator) * c.representation a) ∈ _ at h
    simpa only [map_sub, map_mul, interiorModuleTensorOperatorHom_apply,
      gradedKasparovTensorRepresentation_apply] using h
  second_square_mem := productSecondDefectGenerators_mem c d G (Or.inl (Or.inl (Or.inl rfl)))
  second_commutator_mem a := productSecondDefectGenerators_mem c d G (Or.inl (Or.inr ⟨a, rfl⟩))
  second_equivariance_mem g := productSecondDefectGenerators_mem c d G (Or.inr ⟨g, rfl⟩)
  anticommutator_mem := productSecondDefectGenerators_mem c d G (Or.inl (Or.inl (Or.inr rfl)))

end BC4lean.KKTheory
