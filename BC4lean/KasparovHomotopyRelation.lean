import BC4lean.ConeKasparovHomotopy
import BC4lean.KasparovFibreOpposite
import Mathlib.Logic.Relation

/-! # The relation generated by genuine interval Kasparov homotopies

A full interval witness consists of an actual cycle over `C([0,1],B)` on an
arbitrary complete, countably generated Hilbert module, together with actual
whole-cycle isomorphisms from its two evaluated fibres to the specified cycles.
The module carrier may vary, within the explicit module universe `uE`.

`Homotopic` is the equivalence relation generated by these witnesses and genuine
cycle isomorphisms. It is not asserted here that every finite chain is represented
by a single interval witness; that requires a separate gluing construction.
Exact degeneracy is proved to give a zero class through the actual cone cycle.
-/

noncomputable section

universe uΓ uA uB uE

namespace BC4lean.KKTheory

variable {Γ : Type uΓ} {A : Type uA} {B : Type uB} [Group Γ]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]
  [PartialOrder B] [StarOrderedRing B]
  {α : CStarAlgebraAction Γ A} {β : CStarAlgebraAction Γ B}

/-- A genuine full interval homotopy with endpoint identifications of the entire
cycle, using the completed evaluated-inner-product fibres. -/
structure FullKasparovHomotopy
    (c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) where
  intervalCycle : BundledKasparovCycle.{uΓ, uA, uB, uE} α
    (β.continuousSections (X := unitInterval))
  sourceIso : KasparovCycleIso (intervalCycle.cycle.fibre 0) c.cycle
  targetIso : KasparovCycleIso (intervalCycle.cycle.fibre 1) d.cycle

namespace FullKasparovHomotopy

variable {c d e f : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}

/-- Changing endpoint identifications retains the same actual interval module. -/
def changeEndpoints (h : FullKasparovHomotopy c d) (u : c.Iso e) (v : d.Iso f) :
    FullKasparovHomotopy e f where
  intervalCycle := h.intervalCycle
  sourceIso := h.sourceIso.trans u
  targetIso := h.targetIso.trans v

variable {E : Type uE} [NormedAddCommGroup E] [NormedSpace ℂ E]
  [SMul Bᵐᵒᵖ E] [CStarModule Bᵐᵒᵖ E] [CompleteSpace E]

/-- A fixed-module operator path yields a full interval witness only through
the actual section module, compactness lift, and genuine general-fibre isomorphisms. -/
def ofOperatorHomotopy {c : KasparovCycle α β E} {T₀ T₁ : AdjointableMap B E E}
    (h : KasparovOperatorHomotopy c T₀ T₁) :
    FullKasparovHomotopy
      (BundledKasparovCycle.of (c.withOperator T₀ h.source_conditions))
      (BundledKasparovCycle.of (c.withOperator T₁ h.target_conditions)) where
  intervalCycle := BundledKasparovCycle.of h.intervalCycle
  sourceIso := h.intervalFibreZeroIso
  targetIso := h.intervalFibreOneIso

/-- The constant interval cycle supplies an actual reflexive full witness. -/
def refl (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) : FullKasparovHomotopy c c where
  intervalCycle := BundledKasparovCycle.of (KasparovOperatorHomotopy.refl c.cycle).intervalCycle
  sourceIso := by
    change KasparovCycleIso ((KasparovOperatorHomotopy.refl c.cycle).intervalCycle.fibre 0) c.cycle
    simpa only [KasparovCycle.withOperator_self] using
      (KasparovOperatorHomotopy.refl c.cycle).intervalFibreZeroIso
  targetIso := by
    change KasparovCycleIso ((KasparovOperatorHomotopy.refl c.cycle).intervalCycle.fibre 1) c.cycle
    simpa only [KasparovCycle.withOperator_self] using
      (KasparovOperatorHomotopy.refl c.cycle).intervalFibreOneIso

/-- A genuine cycle isomorphism is itself represented by a constant full
interval cycle with that isomorphism as the target identification. -/
def ofIso (u : c.Iso d) : FullKasparovHomotopy c d :=
  (refl c).changeEndpoints (BundledKasparovCycle.isoRefl c) u

/-- Opposite interval data has the opposite endpoint cycles, by actual fibre
unitaries and the original endpoint unitary identifications. -/
def opposite (h : FullKasparovHomotopy c d) : FullKasparovHomotopy c.opposite d.opposite where
  intervalCycle := h.intervalCycle.opposite
  sourceIso := (KasparovCycleIso.fibreOpposite h.intervalCycle.cycle 0).trans
    h.sourceIso.opposite
  targetIso := (KasparovCycleIso.fibreOpposite h.intervalCycle.cycle 1).trans
    h.targetIso.opposite

/-- The genuine cone witness joins the actual zero cycle to an exactly
degenerate cycle. No degeneracy relation is postulated. -/
def degenerateCone (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β)
    (hc : c.cycle.IsDegenerate) : FullKasparovHomotopy (BundledKasparovCycle.zero α β) c where
  intervalCycle := BundledKasparovCycle.of (c.cycle.degenerateCone hc)
  sourceIso := c.cycle.degenerateConeZeroFibreIso hc
  targetIso := c.cycle.degenerateConeOneFibreIso hc

/-- The inverse rotation is lifted to a genuine full interval witness ending
at its actual degenerate flip cycle. -/
def inverseRotation (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    FullKasparovHomotopy (c.directSum c.opposite)
      (BundledKasparovCycle.of ((KasparovOperatorHomotopy.inverseRotation c.cycle).cycleAt 1)) where
  intervalCycle := BundledKasparovCycle.of
    (KasparovOperatorHomotopy.inverseRotation c.cycle).intervalCycle
  sourceIso := by
    change KasparovCycleIso ((KasparovOperatorHomotopy.inverseRotation c.cycle).intervalCycle.fibre 0)
      (c.cycle.directSum c.cycle.opposite)
    simpa only [KasparovOperatorHomotopy.source_cycleAt, KasparovCycle.withOperator_self] using
      (KasparovOperatorHomotopy.inverseRotation c.cycle).intervalFibreIso 0
  targetIso := (KasparovOperatorHomotopy.inverseRotation c.cycle).intervalFibreIso 1

end FullKasparovHomotopy

namespace BundledKasparovCycle

/-- A generating step is either a genuine cycle isomorphism or a genuine full
interval-cycle witness with its completed evaluated endpoint fibres. -/
def HomotopyStep (c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) : Prop :=
  c.Isomorphic d ∨ Nonempty (FullKasparovHomotopy c d)

/-- Isomorphism steps add no unproved equivalences: each is represented by
the actual constant interval cycle with its endpoint unitary. -/
theorem homotopyStep_iff_full {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β} :
    HomotopyStep c d ↔ Nonempty (FullKasparovHomotopy c d) := by
  constructor
  · intro h
    change c.Isomorphic d ∨ Nonempty (FullKasparovHomotopy c d) at h
    rcases h with h | h
    · obtain ⟨u⟩ := h
      exact ⟨FullKasparovHomotopy.ofIso u⟩
    · exact h
  · exact Or.inr

/-- The equivalence relation generated by actual full interval witnesses and
actual varying-module cycle isomorphisms. -/
def Homotopic (c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) : Prop :=
  Relation.EqvGen HomotopyStep c d

@[refl] theorem homotopic_refl (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    c.Homotopic c := Relation.EqvGen.refl c

@[symm] theorem homotopic_symm {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : c.Homotopic d) : d.Homotopic c := Relation.EqvGen.symm c d h

@[trans] theorem homotopic_trans {c d k : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : c.Homotopic d) (h' : d.Homotopic k) : c.Homotopic k :=
  Relation.EqvGen.trans c d k h h'

/-- Every actual unitary cycle isomorphism gives a generating equivalence. -/
theorem homotopic_of_iso {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (u : c.Iso d) : c.Homotopic d := Relation.EqvGen.rel c d (Or.inl ⟨u⟩)

/-- Every genuine full interval witness gives a generating equivalence. -/
theorem homotopic_of_full {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : FullKasparovHomotopy c d) : c.Homotopic d :=
  Relation.EqvGen.rel c d (Or.inr ⟨h⟩)

/-- The actual proved equivalence relation used for the generated quotient. -/
def homotopySetoid : Setoid (BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :=
  Relation.EqvGen.setoid HomotopyStep

/-- Opposite respects each generating interval or unitary step and hence
respects their equivalence closure. -/
theorem homotopic_opposite {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : c.Homotopic d) : c.opposite.Homotopic d.opposite := by
  induction h with
  | rel a b h =>
      change a.Isomorphic b ∨ Nonempty (FullKasparovHomotopy a b) at h
      rcases h with h | h
      · obtain ⟨u⟩ := h
        exact homotopic_of_iso (oppositeIso u)
      · obtain ⟨h⟩ := h
        exact homotopic_of_full h.opposite
  | refl => exact homotopic_refl _
  | symm a b _ ih => exact homotopic_symm ih
  | trans a b k _ _ hab hbk => exact homotopic_trans hab hbk

/-- Exact degeneracy implies equivalence to the actual zero cycle through
the genuine cone interval module. -/
theorem degenerate_homotopic_zero (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β)
    (hc : c.cycle.IsDegenerate) : c.Homotopic (zero α β) :=
  homotopic_symm (homotopic_of_full (FullKasparovHomotopy.degenerateCone c hc))

/-- A cycle plus its opposite is equivalent to zero by the actual inverse
rotation interval cycle followed by the actual cone of its degenerate endpoint. -/
theorem directSum_opposite_homotopic_zero
    (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    (c.directSum c.opposite).Homotopic (zero α β) :=
  homotopic_trans (homotopic_of_full (FullKasparovHomotopy.inverseRotation c))
    (degenerate_homotopic_zero _ (KasparovOperatorHomotopy.inverseRotation_target_isDegenerate c.cycle))

/-- Commutativity of direct sum is supplied by its actual summand-swap unitary. -/
theorem directSum_comm_homotopic (c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    (c.directSum d).Homotopic (d.directSum c) := homotopic_of_iso (directSumCommIso c d)

/-- Associativity of direct sum is supplied by its genuine reassociation unitary. -/
theorem directSum_assoc_homotopic
    (c d k : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    ((c.directSum d).directSum k).Homotopic (c.directSum (d.directSum k)) :=
  homotopic_of_iso (directSumAssocIso c d k)

theorem directSum_zero_right_homotopic (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    (c.directSum (zero α β)).Homotopic c := homotopic_of_iso (directSumZeroRightIso c)

theorem directSum_zero_left_homotopic (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    ((zero α β).directSum c).Homotopic c := homotopic_of_iso (directSumZeroLeftIso c)

theorem opposite_directSum_homotopic_zero
    (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    (c.opposite.directSum c).Homotopic (zero α β) :=
  homotopic_trans (directSum_comm_homotopic c.opposite c) (directSum_opposite_homotopic_zero c)

end BundledKasparovCycle
end BC4lean.KKTheory
