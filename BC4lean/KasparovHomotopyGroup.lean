import BC4lean.IntervalKasparovCycleGluing
import BC4lean.KasparovFibreDirectSumIso
import Mathlib.Data.Quot

/-! # The abelian group of generated full-homotopy classes

Addition uses genuine Hilbert-module direct sums. Its descent through actual
full interval homotopies uses the proved unitary identification between the
fibre of a direct sum and the direct sum of the two completed evaluated fibres.
The inverse reverses grading and Fredholm operator. The actual inverse rotation
and cone interval cycles prove the inverse law.

For separable coefficient algebras, actual reversal and matched-pair interval
gluing identify the generated equivalence relation with the existence of one
full arbitrary-module interval witness, as in the source's Definition 3.4.
Thus equality of classes is exactly that textbook full-homotopy relation in
the separable setting. The group construction itself also makes sense for
arbitrary coefficient algebras using the explicitly generated relation.
-/

noncomputable section

universe uΓ uA uB uE

namespace BC4lean.KKTheory

variable {Γ : Type uΓ} {A : Type uA} {B : Type uB} [Group Γ]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B]
  [PartialOrder B] [StarOrderedRing B]
  {α : CStarAlgebraAction Γ A} {β : CStarAlgebraAction Γ B}

namespace FullKasparovHomotopy

/-- Genuine direct sum of arbitrary full interval witnesses. The endpoint
identifications use the actual sum-fibre unitary before the original endpoint
cycle isomorphisms are applied diagonally. -/
def directSum {c d k l : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : FullKasparovHomotopy c d) (h' : FullKasparovHomotopy k l) :
    FullKasparovHomotopy (c.directSum k) (d.directSum l) where
  intervalCycle := h.intervalCycle.directSum h'.intervalCycle
  sourceIso := (KasparovCycleIso.fibreDirectSum
    h.intervalCycle.cycle h'.intervalCycle.cycle 0).trans (h.sourceIso.directSum h'.sourceIso)
  targetIso := (KasparovCycleIso.fibreDirectSum
    h.intervalCycle.cycle h'.intervalCycle.cycle 1).trans (h.targetIso.directSum h'.targetIso)

end FullKasparovHomotopy

namespace BundledKasparovCycle

/-- Adding a fixed actual cycle preserves each full interval or unitary step,
and therefore preserves the generated equivalence relation. -/
theorem homotopic_directSum_left {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : c.Homotopic d) (k : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    (c.directSum k).Homotopic (d.directSum k) := by
  induction h with
  | rel a b h =>
      change a.Isomorphic b ∨ Nonempty (FullKasparovHomotopy a b) at h
      rcases h with h | h
      · obtain ⟨u⟩ := h
        exact homotopic_of_iso (directSumIso u (isoRefl k))
      · obtain ⟨h⟩ := h
        exact homotopic_of_full (h.directSum (FullKasparovHomotopy.refl k))
  | refl => exact homotopic_refl _
  | symm a b _ ih => exact homotopic_symm ih
  | trans a b l _ _ hab hbl => exact homotopic_trans hab hbl

/-- Congruence in the second summand follows using actual summand-exchange
unitaries and the proved congruence in the first summand. -/
theorem homotopic_directSum_right {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : c.Homotopic d) (k : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    (k.directSum c).Homotopic (k.directSum d) :=
  homotopic_trans (directSum_comm_homotopic k c)
    (homotopic_trans (homotopic_directSum_left h k) (directSum_comm_homotopic d k))

/-- Direct sum respects the generated relation in both actual module variables. -/
theorem homotopic_directSum {c d k l : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : c.Homotopic d) (h' : k.Homotopic l) :
    (c.directSum k).Homotopic (d.directSum l) :=
  homotopic_trans (homotopic_directSum_left h k) (homotopic_directSum_right h' d)

end BundledKasparovCycle

/-- Classes for the equivalence relation generated by genuine full interval
Kasparov homotopies and genuine varying-module cycle isomorphisms. The module
universe is fixed explicitly; no arbitrary tagged substitute for a module is used. -/
def KasparovHomotopyClass (α : CStarAlgebraAction Γ A) (β : CStarAlgebraAction Γ B) :=
  Quotient (BundledKasparovCycle.homotopySetoid.{uΓ, uA, uB, uE} (α := α) (β := β))

namespace KasparovHomotopyClass

/-- The class of a raw cycle together with its actual stored Hilbert module. -/
def mk (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    KasparovHomotopyClass.{uΓ, uA, uB, uE} α β := Quotient.mk _ c

theorem mk_eq_mk {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β} :
    mk c = mk d ↔ c.Homotopic d := by
  constructor
  · intro h
    exact Quotient.exact h
  · intro h
    exact Quotient.sound (s := BundledKasparovCycle.homotopySetoid (α := α) (β := β)) h

/-- Equality of classes is precisely one genuine arbitrary-module interval
homotopy in the source's separable-coefficient setting. -/
theorem mk_eq_mk_iff_full [TopologicalSpace.SeparableSpace B]
    {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β} :
    mk c = mk d ↔ Nonempty (FullKasparovHomotopy c d) :=
  mk_eq_mk.trans BundledKasparovCycle.homotopic_iff_full

/-- Isomorphic cycles define the same class by their actual cycle unitary. -/
theorem mk_eq_of_iso {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (u : c.Iso d) : mk c = mk d :=
  Quotient.sound (BundledKasparovCycle.homotopic_of_iso u)

/-- Actual arbitrary-module full interval homotopies define equal classes. -/
theorem mk_eq_of_full {c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β}
    (h : FullKasparovHomotopy c d) : mk c = mk d :=
  Quotient.sound (BundledKasparovCycle.homotopic_of_full h)

instance instZero : Zero (KasparovHomotopyClass.{uΓ, uA, uB, uE} α β) where
  zero := mk (BundledKasparovCycle.zero α β)

instance instAdd : Add (KasparovHomotopyClass.{uΓ, uA, uB, uE} α β) where
  add := Quotient.lift₂
    (fun (c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) => mk (c.directSum d))
    (fun _ _ _ _ h h' => Quotient.sound (BundledKasparovCycle.homotopic_directSum h h'))

instance instNeg : Neg (KasparovHomotopyClass.{uΓ, uA, uB, uE} α β) where
  neg := Quotient.lift
    (fun (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) => mk c.opposite)
    (fun _ _ h => Quotient.sound (BundledKasparovCycle.homotopic_opposite h))

@[simp] theorem mk_zero : mk (BundledKasparovCycle.zero α β) =
    (0 : KasparovHomotopyClass.{uΓ, uA, uB, uE} α β) := rfl

@[simp] theorem mk_directSum (c d : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    mk (c.directSum d) = mk c + mk d := rfl

@[simp] theorem mk_opposite (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β) :
    mk c.opposite = -mk c := rfl

/-- The group laws are proved by actual cycle unitaries, genuine full interval
sum congruence, the inverse rotation interval cycle, and the degenerate cone. -/
instance instAddCommGroup : AddCommGroup (KasparovHomotopyClass.{uΓ, uA, uB, uE} α β) where
  add_assoc x y z := by
    refine Quotient.inductionOn₃' x y z ?_
    intro c d k
    exact Quotient.sound (BundledKasparovCycle.directSum_assoc_homotopic c d k)
  zero_add x := by
    refine Quotient.inductionOn' x ?_
    intro c
    exact Quotient.sound (BundledKasparovCycle.directSum_zero_left_homotopic c)
  add_zero x := by
    refine Quotient.inductionOn' x ?_
    intro c
    exact Quotient.sound (BundledKasparovCycle.directSum_zero_right_homotopic c)
  add_comm x y := by
    refine Quotient.inductionOn₂' x y ?_
    intro c d
    exact Quotient.sound (BundledKasparovCycle.directSum_comm_homotopic c d)
  neg_add_cancel x := by
    refine Quotient.inductionOn' x ?_
    intro c
    exact Quotient.sound (BundledKasparovCycle.opposite_directSum_homotopic_zero c)
  nsmul := nsmulRec
  zsmul := zsmulRec

/-- The zero-class assertion for a degenerate cycle is a consequence of its
constructed full cone homotopy. -/
theorem mk_eq_zero_of_degenerate (c : BundledKasparovCycle.{uΓ, uA, uB, uE} α β)
    (hc : c.cycle.IsDegenerate) : mk c = (0 : KasparovHomotopyClass α β) :=
  Quotient.sound (BundledKasparovCycle.degenerate_homotopic_zero c hc)

/-- Every class has an actual bundled cycle representative. -/
theorem mk_surjective : Function.Surjective
    (mk (α := α) (β := β) : BundledKasparovCycle.{uΓ, uA, uB, uE} α β →
      KasparovHomotopyClass.{uΓ, uA, uB, uE} α β) := Quotient.mk_surjective

end KasparovHomotopyClass
end BC4lean.KKTheory
