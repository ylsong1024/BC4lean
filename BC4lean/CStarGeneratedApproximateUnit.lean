import BC4lean.CStarSigmaUnitalQuasicentral
import Mathlib.Topology.Algebra.NonUnitalStarAlgebra
import Mathlib.Analysis.Normed.Operator.Mul

/-! # Genuine countable approximate units of generated closed algebras

Two countable two-sided approximate units give one countable two-sided
approximate unit of the closed star algebra generated by their coefficient
algebras. The proof constructs the sequence from canonical order tails and
extends its convergence through the actual norm closure. No separability of
the ambient algebra, or essentiality of a representation, is used.
-/

noncomputable section
namespace BC4lean.KKTheory

open Filter
open scoped Topology

section ConvergenceAlgebra
variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- The elements on which a selfadjoint sequence acts as a two-sided
approximate identity form an actual star subalgebra. -/
def approximateUnitConvergenceAlgebra (u : ℕ → A)
    (hstar : ∀ n, star (u n) = u n) : NonUnitalStarSubalgebra ℂ A where
  carrier := {a | Tendsto (fun n => u n * a) atTop (𝓝 a) ∧
    Tendsto (fun n => a * u n) atTop (𝓝 a)}
  zero_mem' := by simp
  add_mem' := fun ha hb => ⟨by simpa [mul_add] using ha.1.add hb.1,
    by simpa [add_mul] using ha.2.add hb.2⟩
  mul_mem' := fun ha hb => ⟨by simpa [mul_assoc] using ha.1.mul_const _,
    by simpa [mul_assoc] using hb.2.const_mul _⟩
  smul_mem' := fun c a ha => ⟨by simpa [mul_smul_comm] using ha.1.const_smul c,
    by simpa [smul_mul_assoc] using ha.2.const_smul c⟩
  star_mem' := fun ha => ⟨by simpa [star_mul, hstar] using ha.2.star,
    by simpa [star_mul, hstar] using ha.1.star⟩

/-- Uniform contractivity makes two-sided approximate-unit convergence
closed under norm limits. -/
theorem approximateUnitConvergenceAlgebra_isClosed (u : ℕ → A)
    (hstar : ∀ n, star (u n) = u n) (hu : ∀ n, ‖u n‖ ≤ 1) :
    IsClosed (approximateUnitConvergenceAlgebra u hstar : Set A) := by
  let L : ℕ → A →L[ℂ] A := fun n => ContinuousLinearMap.mul ℂ A (u n)
  let R : ℕ → A →L[ℂ] A := fun n => (ContinuousLinearMap.mul ℂ A).flip (u n)
  have hL : ∀ᶠ n : ℕ in atTop, ‖L n‖ ≤ 1 := Eventually.of_forall fun n =>
    (ContinuousLinearMap.opNorm_mul_apply_le ℂ A (u n)).trans (hu n)
  have hR : ∀ᶠ n : ℕ in atTop, ‖R n‖ ≤ 1 := Eventually.of_forall fun n => by
    apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
    intro a
    change ‖a * u n‖ ≤ 1 * ‖a‖
    calc
      ‖a * u n‖ ≤ ‖a‖ * ‖u n‖ := norm_mul_le a (u n)
      _ ≤ ‖a‖ * 1 := mul_le_mul_of_nonneg_left (hu n) (norm_nonneg a)
      _ = 1 * ‖a‖ := by simp
  have hclosedL := strongConvergenceSubmodule_isClosed L (.id ℂ A) 1 zero_le_one hL
  have hclosedR := strongConvergenceSubmodule_isClosed R (.id ℂ A) 1 zero_le_one hR
  exact hclosedL.inter hclosedR

/-- One genuine approximate-unit sequence may be used as a countable set
of tests for another uniformly contractive sequence. -/
theorem tendsto_twoSided_mul_of_approximateUnit_tests (u q : ℕ → A)
    (hu : ∀ n, ‖u n‖ ≤ 1) (a : A)
    (haq : Tendsto (fun k => a * q k) atTop (𝓝 a))
    (hqa : Tendsto (fun k => q k * a) atTop (𝓝 a))
    (hqu : ∀ k, Tendsto (fun n => q k * u n) atTop (𝓝 (q k)))
    (huq : ∀ k, Tendsto (fun n => u n * q k) atTop (𝓝 (q k))) :
    Tendsto (fun n => a * u n) atTop (𝓝 a) ∧
      Tendsto (fun n => u n * a) atTop (𝓝 a) := by
  have hright : Tendsto (fun n => a * u n) atTop (𝓝 a) := by
    apply Metric.tendsto_atTop.mpr
    intro ε hε
    have hq : Tendsto (fun k => ‖a - a * q k‖) atTop (𝓝 0) := by
      simpa using ((tendsto_const_nhds (x := a)).sub haq).norm
    obtain ⟨k, hk⟩ := (hq.eventually (gt_mem_nhds (by positivity : 0 < ε / 4))).exists
    have htest : Tendsto (fun n => ‖q k * u n - q k‖) atTop (𝓝 0) := by
      simpa using ((hqu k).sub (tendsto_const_nhds (x := q k))).norm
    obtain ⟨N, hN⟩ := eventually_atTop.mp
      (htest.eventually (gt_mem_nhds (by positivity : 0 < ε / (2 * (‖a‖ + 1)))))
    refine ⟨N, fun n hn => ?_⟩
    have he := NormalizedQuasicentral.norm_right_unit_error_via_test (u n) a (q k) (hu n)
    have hs := (lt_div_iff₀ (by positivity : 0 < 2 * (‖a‖ + 1))).mp (hN n hn)
    rw [dist_eq_norm]
    nlinarith [norm_nonneg (q k * u n - q k)]
  have hleft : Tendsto (fun n => u n * a) atTop (𝓝 a) := by
    apply Metric.tendsto_atTop.mpr
    intro ε hε
    have hq : Tendsto (fun k => ‖a - q k * a‖) atTop (𝓝 0) := by
      simpa using ((tendsto_const_nhds (x := a)).sub hqa).norm
    obtain ⟨k, hk⟩ := (hq.eventually (gt_mem_nhds (by positivity : 0 < ε / 4))).exists
    have htest : Tendsto (fun n => ‖u n * q k - q k‖) atTop (𝓝 0) := by
      simpa using ((huq k).sub (tendsto_const_nhds (x := q k))).norm
    obtain ⟨N, hN⟩ := eventually_atTop.mp
      (htest.eventually (gt_mem_nhds (by positivity : 0 < ε / (2 * (‖a‖ + 1)))))
    refine ⟨N, fun n hn => ?_⟩
    have he := NormalizedQuasicentral.norm_left_unit_error_via_test (u n) a (q k) (hu n)
    have hs := (lt_div_iff₀ (by positivity : 0 < 2 * (‖a‖ + 1))).mp (hN n hn)
    rw [dist_eq_norm]
    nlinarith [norm_nonneg (u n * q k - q k)]
  exact ⟨hright, hleft⟩

end ConvergenceAlgebra

section GeneratedAlgebra
variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- The actual closed coefficient algebra used when adjoining the compact
ideal to the first algebra in the technical theorem. -/
def generatedClosedStarAlgebra (S T : NonUnitalStarSubalgebra ℂ A) :
    NonUnitalStarSubalgebra ℂ A :=
  (NonUnitalStarAlgebra.adjoin ℂ ((S : Set A) ∪ (T : Set A))).topologicalClosure

instance generatedClosedStarAlgebra_isClosed (S T : NonUnitalStarSubalgebra ℂ A) :
    IsClosed (generatedClosedStarAlgebra S T : Set A) :=
  NonUnitalStarSubalgebra.isClosed_topologicalClosure _

local instance (S T : NonUnitalStarSubalgebra ℂ A) :
    PartialOrder (generatedClosedStarAlgebra S T) := CStarAlgebra.spectralOrder _
local instance (S T : NonUnitalStarSubalgebra ℂ A) :
    StarOrderedRing (generatedClosedStarAlgebra S T) := CStarAlgebra.spectralOrderedRing _

theorem le_generatedClosedStarAlgebra_left (S T : NonUnitalStarSubalgebra ℂ A) :
    S ≤ generatedClosedStarAlgebra S T := fun _ ha =>
  NonUnitalStarSubalgebra.le_topologicalClosure _
    (NonUnitalStarAlgebra.subset_adjoin ℂ _ (Or.inl ha))

theorem le_generatedClosedStarAlgebra_right (S T : NonUnitalStarSubalgebra ℂ A) :
    T ≤ generatedClosedStarAlgebra S T := fun _ ha =>
  NonUnitalStarSubalgebra.le_topologicalClosure _
    (NonUnitalStarAlgebra.subset_adjoin ℂ _ (Or.inr ha))

/-- Closure induction for the actual generated star algebra. -/
theorem generatedClosedStarAlgebra_le (S T R : NonUnitalStarSubalgebra ℂ A)
    (hR : IsClosed (R : Set A)) (hS : S ≤ R) (hT : T ≤ R) :
    generatedClosedStarAlgebra S T ≤ R :=
  NonUnitalStarSubalgebra.topologicalClosure_minimal _
    (NonUnitalStarAlgebra.adjoin_le (Set.union_subset hS hT)) hR

/-- A genuine increasing positive contractive countable approximate unit
exists for the closed algebra generated by two specified sigma-unital
subalgebras. Sigma-unitality is expressed by actual two-sided limits. -/
theorem exists_generatedClosedStarAlgebra_approximateUnit
    (S T : NonUnitalStarSubalgebra ℂ A)
    (qS : ℕ → S) (qT : ℕ → T)
    (hSleft : ∀ a : S, Tendsto (fun n => a * qS n) atTop (𝓝 a))
    (hSright : ∀ a : S, Tendsto (fun n => qS n * a) atTop (𝓝 a))
    (hTleft : ∀ a : T, Tendsto (fun n => a * qT n) atTop (𝓝 a))
    (hTright : ∀ a : T, Tendsto (fun n => qT n * a) atTop (𝓝 a)) :
    ∃ u : ℕ → generatedClosedStarAlgebra S T, u 0 = 0 ∧ Monotone u ∧
      (∀ n, 0 ≤ u n) ∧ (∀ n, ‖u n‖ < 1) ∧ (∀ n, star (u n) = u n) ∧
      (∀ a, Tendsto (fun n => a * u n) atTop (𝓝 a)) ∧
      (∀ a, Tendsto (fun n => u n * a) atTop (𝓝 a)) := by
  classical
  let U := generatedClosedStarAlgebra S T
  let : PartialOrder U := CStarAlgebra.spectralOrder U
  let : StarOrderedRing U := CStarAlgebra.spectralOrderedRing U
  let qs : ℕ → U := fun n => ⟨qS n, le_generatedClosedStarAlgebra_left S T (qS n).property⟩
  let qt : ℕ → U := fun n => ⟨qT n, le_generatedClosedStarAlgebra_right S T (qT n).property⟩
  let P := {p : U // 0 ≤ p ∧ ‖p‖ < 1}
  have hselect (n : ℕ) (p : P) : ∃ e : U, p.val ≤ e ∧ 0 ≤ e ∧ ‖e‖ < 1 ∧
      (∀ k ≤ n, ‖qs k * e - qs k‖ < 1 / ((n : ℝ) + 1) ∧
        ‖e * qs k - qs k‖ < 1 / ((n : ℝ) + 1)) ∧
      (∀ k ≤ n, ‖qt k * e - qt k‖ < 1 / ((n : ℝ) + 1) ∧
        ‖e * qt k - qt k‖ < 1 / ((n : ℝ) + 1)) := by
    obtain ⟨e, hep, he0, he1, _, _, _, heq⟩ :=
      NormalizedQuasicentral.exists_positive_strict_contraction_finite_errors_above
        (Unitization.inrNonUnitalStarAlgHom ℂ U) Unitization.inr_injective
        p.val p.property.1 p.property.2 ∅ ∅
        (((Finset.range (n + 1)).image qs) ∪ ((Finset.range (n + 1)).image qt))
        (by simp) (by simp) (1 / ((n : ℝ) + 1)) (by positivity)
    refine ⟨e, hep, he0, he1, ?_, ?_⟩
    · intro k hk
      exact heq _ (Finset.mem_union_left _ (Finset.mem_image.mpr
        ⟨k, Finset.mem_range.mpr (Nat.lt_succ_of_le hk), rfl⟩))
    · intro k hk
      exact heq _ (Finset.mem_union_right _ (Finset.mem_image.mpr
        ⟨k, Finset.mem_range.mpr (Nat.lt_succ_of_le hk), rfl⟩))
  choose v hvAbove hv0 hv1 hvS hvT using hselect
  let recU : ℕ → P := Nat.rec ⟨0, by simp⟩
    (fun n p => ⟨v n p, hv0 n p, hv1 n p⟩)
  let u : ℕ → U := fun n => (recU n).val
  have hu0 (n : ℕ) : 0 ≤ u n := (recU n).property.1
  have hu1 (n : ℕ) : ‖u n‖ < 1 := (recU n).property.2
  have hustar (n : ℕ) : star (u n) = u n := (IsSelfAdjoint.of_nonneg (hu0 n)).star_eq
  have huMono : Monotone u := monotone_nat_of_le_succ fun n => hvAbove n (recU n)
  have htests (q : ℕ → U)
      (herr : ∀ n k, k ≤ n → ‖q k * u (n + 1) - q k‖ < 1 / ((n : ℝ) + 1) ∧
        ‖u (n + 1) * q k - q k‖ < 1 / ((n : ℝ) + 1)) (k : ℕ) :
      Tendsto (fun n => q k * u n) atTop (𝓝 (q k)) ∧
        Tendsto (fun n => u n * q k) atTop (𝓝 (q k)) := by
    have hside (z : ℕ → U)
        (hz : ∀ n ≥ k, ‖z (n + 1) - q k‖ < 1 / ((n : ℝ) + 1)) :
        Tendsto z atTop (𝓝 (q k)) := by
      apply (tendsto_add_atTop_iff_nat 1).mp
      apply Metric.tendsto_atTop.mpr
      intro ε hε
      obtain ⟨N, hN⟩ := eventually_atTop.mp
        ((tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).eventually (gt_mem_nhds hε))
      refine ⟨max N k, fun n hn => ?_⟩
      rw [dist_eq_norm]
      exact (hz n ((le_max_right N k).trans hn)).trans
        (hN n ((le_max_left N k).trans hn))
    exact ⟨hside _ (fun n hn => (herr n k hn).1),
      hside _ (fun n hn => (herr n k hn).2)⟩
  have hqs := htests qs (fun n k hk => hvS n (recU n) k hk)
  have hqt := htests qt (fun n k hk => hvT n (recU n) k hk)
  let ua : ℕ → A := fun n => (u n : A)
  have hbound (n : ℕ) : ‖ua n‖ ≤ 1 := (hu1 n).le
  have hstar (n : ℕ) : star (ua n) = ua n := congrArg Subtype.val (hustar n)
  let R := approximateUnitConvergenceAlgebra ua hstar
  have hS : S ≤ R := by
    intro a ha
    let x : S := ⟨a, ha⟩
    have hx := tendsto_twoSided_mul_of_approximateUnit_tests ua (fun k => (qS k : A))
      hbound a
      (by simpa [Function.comp_def, x] using (continuous_subtype_val.tendsto x).comp (hSleft x))
      (by simpa [Function.comp_def, x] using (continuous_subtype_val.tendsto x).comp (hSright x))
      (fun k => by simpa [Function.comp_def, qs, ua] using
        (continuous_subtype_val.tendsto (qs k)).comp (hqs k).1)
      (fun k => by simpa [Function.comp_def, qs, ua] using
        (continuous_subtype_val.tendsto (qs k)).comp (hqs k).2)
    exact ⟨hx.2, hx.1⟩
  have hT : T ≤ R := by
    intro a ha
    let x : T := ⟨a, ha⟩
    have hx := tendsto_twoSided_mul_of_approximateUnit_tests ua (fun k => (qT k : A))
      hbound a
      (by simpa [Function.comp_def, x] using (continuous_subtype_val.tendsto x).comp (hTleft x))
      (by simpa [Function.comp_def, x] using (continuous_subtype_val.tendsto x).comp (hTright x))
      (fun k => by simpa [Function.comp_def, qt, ua] using
        (continuous_subtype_val.tendsto (qt k)).comp (hqt k).1)
      (fun k => by simpa [Function.comp_def, qt, ua] using
        (continuous_subtype_val.tendsto (qt k)).comp (hqt k).2)
    exact ⟨hx.2, hx.1⟩
  have hU : U ≤ R := generatedClosedStarAlgebra_le S T R
    (approximateUnitConvergenceAlgebra_isClosed ua hstar hbound) hS hT
  refine ⟨u, rfl, huMono, hu0, hu1, hustar, ?_, ?_⟩
  · intro a
    apply (isometry_subtype_coe (s := (U : Set A))).tendsto_nhds_iff.mpr
    simpa [Function.comp_def, ua] using (hU a.property).2
  · intro a
    apply (isometry_subtype_coe (s := (U : Set A))).tendsto_nhds_iff.mpr
    simpa [Function.comp_def, ua] using (hU a.property).1

end GeneratedAlgebra
end BC4lean.KKTheory
