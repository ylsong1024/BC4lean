import BC4lean.KasparovTechnicalProductApplication
import BC4lean.KasparovAugmentedAlgebra
import BC4lean.CompactModuleStrongCutoff
import BC4lean.CompactModuleCountableApproximateUnit

/-! # Concrete sandwich algebras for the genuine product application

The first algebra is the norm-closed star algebra generated by the two
actual creation sandwich families and the actual compact tensor ideal.
The second creation-local algebra is used as a containing algebra for the
separably generated defect algebra. Products into the compact ideal and
normalization are proved on the genuine generators and extended through
the star algebra operations and norm closure.
-/

noncomputable section
namespace BC4lean.KKTheory

open Filter
open scoped InnerProductSpace Topology Pointwise

section ClosedAdjoin
variable {D : Type*} [NonUnitalCStarAlgebra D]

/-- The actual closed star algebra generated by a specified set. -/
def closedNonUnitalStarAdjoin (s : Set D) : NonUnitalStarSubalgebra ℂ D :=
  (NonUnitalStarAlgebra.adjoin ℂ s).topologicalClosure

theorem closedNonUnitalStarAdjoin_isClosed (s : Set D) :
    IsClosed (closedNonUnitalStarAdjoin s : Set D) :=
  NonUnitalStarSubalgebra.isClosed_topologicalClosure _

theorem subset_closedNonUnitalStarAdjoin (s : Set D) :
    s ⊆ closedNonUnitalStarAdjoin s :=
  (NonUnitalStarAlgebra.subset_adjoin ℂ s).trans
    (NonUnitalStarSubalgebra.le_topologicalClosure _)

theorem closedNonUnitalStarAdjoin_le (s : Set D) (T : NonUnitalStarSubalgebra ℂ D)
    (hT : IsClosed (T : Set D)) (hs : s ⊆ T) : closedNonUnitalStarAdjoin s ≤ T :=
  NonUnitalStarSubalgebra.topologicalClosure_minimal _
    (NonUnitalStarAlgebra.adjoin_le hs) hT

/-- Commutator normalization passes from the actual generating set,
including the star companion, through the star operations and closure. -/
theorem normalizes_closedNonUnitalStarAdjoin (s : Set D) (d : D)
    (hd : ∀ a ∈ s, d * a - a * d ∈ closedNonUnitalStarAdjoin s)
    (hdstar : ∀ a ∈ s, star d * a - a * star d ∈ closedNonUnitalStarAdjoin s) :
    ∀ a ∈ closedNonUnitalStarAdjoin s, d * a - a * d ∈ closedNonUnitalStarAdjoin s := by
  let U := closedNonUnitalStarAdjoin s
  let W := NonUnitalStarAlgebra.adjoin ℂ s
  have hW : W ≤ U := NonUnitalStarSubalgebra.le_topologicalClosure _
  have hbase : ∀ a ∈ W, d * a - a * d ∈ U ∧ star d * a - a * star d ∈ U := by
    intro a ha
    induction ha using NonUnitalStarAlgebra.adjoin_induction with
    | mem a ha => exact ⟨hd a ha, hdstar a ha⟩
    | zero => simp
    | add a b ha hb hda hdb =>
      constructor
      · convert add_mem (s := U) hda.1 hdb.1 using 1
        noncomm_ring
      · convert add_mem (s := U) hda.2 hdb.2 using 1
        noncomm_ring
    | mul a b ha hb hda hdb =>
      constructor
      · convert add_mem (s := U) (mul_mem (s := U) hda.1 (hW hb))
          (mul_mem (s := U) (hW ha) hdb.1) using 1
        noncomm_ring
      · convert add_mem (s := U) (mul_mem (s := U) hda.2 (hW hb))
          (mul_mem (s := U) (hW ha) hdb.2) using 1
        noncomm_ring
    | smul c a ha hda =>
      constructor
      · simpa [mul_smul_comm, smul_mul_assoc, smul_sub] using SMulMemClass.smul_mem (s := U) c hda.1
      · simpa [mul_smul_comm, smul_mul_assoc, smul_sub] using SMulMemClass.smul_mem (s := U) c hda.2
    | star a ha hda =>
      constructor
      · simpa only [star_sub, star_mul, star_star, neg_sub] using neg_mem (s := U) (star_mem (s := U) hda.2)
      · simpa only [star_sub, star_mul, star_star, neg_sub] using neg_mem (s := U) (star_mem (s := U) hda.1)
  have hclosed : IsClosed {a : D | d * a - a * d ∈ U} :=
    (closedNonUnitalStarAdjoin_isClosed s).preimage
      ((continuous_const.mul continuous_id).sub (continuous_id.mul continuous_const))
  exact fun a ha => closure_minimal (fun a ha => (hbase a ha).1) hclosed ha

theorem maps_closedNonUnitalStarAdjoin (s : Set D) (σ : D ≃⋆ₐ[ℂ] D)
    (hs : ∀ a ∈ s, σ a ∈ closedNonUnitalStarAdjoin s) :
    ∀ a ∈ closedNonUnitalStarAdjoin s, σ a ∈ closedNonUnitalStarAdjoin s := by
  let T := (closedNonUnitalStarAdjoin s).comap σ.toNonUnitalStarAlgHom
  exact closedNonUnitalStarAdjoin_le s T
    ((closedNonUnitalStarAdjoin_isClosed s).preimage (StarAlgEquiv.isometry σ).continuous) hs

end ClosedAdjoin

section SandwichAlgebra
variable {B C E F : Type*} [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]
  [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul Bᵐᵒᵖ E] [CStarModule Bᵐᵒᵖ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [SMul Cᵐᵒᵖ F] [CStarModule Cᵐᵒᵖ F]
  [CompleteSpace E] [CompleteSpace F]

/-- A genuine rectangular creation sandwich, with an actual second-factor
operator in its middle. -/
def creationSandwich (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (S : AdjointableMap C F F) (x y : E) :
    AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ) :=
  ((moduleCreationMap φ x).comp S).comp (moduleCreationMap φ y).adjoint

@[simp] theorem creationSandwich_one (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (x y : E) :
    creationSandwich φ 1 x y =
      (moduleCreationMap φ x).comp (moduleCreationMap φ y).adjoint := by
  ext u
  rfl

theorem creationSandwich_adjoint (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (S : AdjointableMap C F F) (x y : E) :
    (creationSandwich φ S x y).adjoint = creationSandwich φ S.adjoint y x := by
  simp only [creationSandwich, AdjointableMap.adjoint_comp, AdjointableMap.adjoint_adjoint]
  ext u
  rfl

/-- The actual first-product generators: both sandwich families and the
genuine compact ideal of the completed interior tensor. -/
def firstProductGenerators (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F) :
    Set (AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ)) :=
  (Set.range (fun p : E × E => creationSandwich φ 1 p.1 p.2) ∪
    Set.range (fun p : E × E => creationSandwich φ S p.1 p.2)) ∪
      (compactModuleOperatorAlgebra (B := C) (E := InteriorModuleTensor (E := E) φ) : Set _)

def firstProductAlgebra (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F) :
    NonUnitalStarSubalgebra ℂ
      (AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ)) :=
  closedNonUnitalStarAdjoin (firstProductGenerators (E := E) φ S)

theorem firstProductAlgebra_isClosed (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (S : AdjointableMap C F F) : IsClosed (firstProductAlgebra (E := E) φ S :
      Set (AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ))) :=
  closedNonUnitalStarAdjoin_isClosed _

theorem creationSandwich_one_mem_firstProductAlgebra
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F) (x y : E) :
    creationSandwich φ 1 x y ∈ firstProductAlgebra φ S :=
  subset_closedNonUnitalStarAdjoin _ (Or.inl (Or.inl ⟨(x, y), rfl⟩))

theorem creationSandwich_mem_firstProductAlgebra
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F) (x y : E) :
    creationSandwich φ S x y ∈ firstProductAlgebra φ S :=
  subset_closedNonUnitalStarAdjoin _ (Or.inl (Or.inr ⟨(x, y), rfl⟩))

theorem moduleCompact_le_firstProductAlgebra
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F) :
    compactModuleOperatorAlgebra (B := C) (E := InteriorModuleTensor (E := E) φ) ≤
      firstProductAlgebra φ S :=
  fun _ h => subset_closedNonUnitalStarAdjoin _ (Or.inr h)

/-- The actual tensor of a first-module compact lies in the first
product algebra, by the genuine rank-one creation identity and closure. -/
theorem tensorCompact_mem_firstProductAlgebra
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F)
    {T : AdjointableMap B E E} (hT : IsModuleCompact T) :
    interiorModuleTensorOperator φ T ∈ firstProductAlgebra φ S := by
  let L := interiorModuleTensorOperatorCLM (E := E) φ
  let Q := (firstProductAlgebra φ S).toSubmodule.comap L.toLinearMap
  have hQ : IsClosed (Q : Set (AdjointableMap B E E)) :=
    (firstProductAlgebra_isClosed φ S).preimage L.continuous
  have hθ (x y : E) : moduleRankOne (B := B) x y ∈ Q := by
    change interiorModuleTensorOperator φ (moduleRankOne x y) ∈ firstProductAlgebra φ S
    rw [interiorModuleTensorOperator_rankOne]
    exact creationSandwich_one_mem_firstProductAlgebra φ S x y
  exact moduleCompact_le_of_isClosed Q hQ hθ hT

theorem compactTensorIdeal_isClosedTwoSided
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) :
    IsClosedTwoSidedStarIdeal
      (compactModuleOperatorAlgebra (B := C) (E := InteriorModuleTensor (E := E) φ)) where
  closed := moduleCompact_isClosed
  left_mul := fun a _ h => mul_mem_moduleCompact_left a h
  right_mul := fun a _ h => mul_mem_moduleCompact_right h a

/-- Every creation-local operator annihilates either actual sandwich
family into the genuine compact ideal, on both sides. -/
theorem creationSandwich_products_compact
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F)
    {T : AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ)}
    (hT : IsCreationLocallyCompact φ T) (x y : E) :
    IsModuleCompact (creationSandwich φ S x y * T) ∧
      IsModuleCompact (T * creationSandwich φ S x y) := by
  constructor
  · change IsModuleCompact ((creationSandwich φ S x y).comp T)
    have h := ((hT y).2.adjoint.comp_left S).comp_left (moduleCreationMap φ x)
    simpa only [creationSandwich, AdjointableMap.adjoint_comp,
      AdjointableMap.adjoint_adjoint, AdjointableMap.comp_assoc] using h
  · change IsModuleCompact (T.comp (creationSandwich φ S x y))
    have h := ((hT x).1.comp_right S).comp_right (moduleCreationMap φ y).adjoint
    simpa only [creationSandwich, AdjointableMap.comp_assoc] using h

/-- The generator product calculation extends to the whole actual closed
first algebra and the genuine creation-local containing algebra. -/
theorem firstProductAlgebra_products_compact
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F)
    {a T : AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ)}
    (ha : a ∈ firstProductAlgebra φ S) (hT : IsCreationLocallyCompact φ T) :
    IsModuleCompact (a * T) ∧ IsModuleCompact (T * a) := by
  let K := compactModuleOperatorAlgebra (B := C) (E := InteriorModuleTensor (E := E) φ)
  let E₂ := creationLocallyCompactAlgebra (E := E) φ
  let hK := compactTensorIdeal_isClosedTwoSided (E := E) φ
  let Q := hK.testMultiplierAlgebra (E₂ : Set _) (fun _ h => star_mem (s := E₂) h)
  have hle : firstProductAlgebra φ S ≤ Q := by
    apply closedNonUnitalStarAdjoin_le _ Q
      (hK.testMultiplierAlgebra_isClosed _ _)
    intro b hb U hU
    rcases hb with (hb | hb) | hb
    · obtain ⟨⟨x, y⟩, rfl⟩ := hb
      exact creationSandwich_products_compact φ 1 hU x y
    · obtain ⟨⟨x, y⟩, rfl⟩ := hb
      exact creationSandwich_products_compact φ S hU x y
    · exact ⟨mul_mem_moduleCompact_right hb U, mul_mem_moduleCompact_left U hb⟩
  exact hle ha T hT

/-- The actual creation adjoint intertwines a first-factor tensor
operator with its genuine adjoint acting on the first vector. -/
theorem creationAdjoint_comp_tensorOperator
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (T : AdjointableMap B E E) (y : E) :
    (moduleCreationMap φ y).adjoint.comp (interiorModuleTensorOperator φ T) =
      (moduleCreationMap φ (T.adjoint y)).adjoint := by
  have h := congrArg AdjointableMap.adjoint
    (moduleCreationMap_tensorOperator φ T.adjoint y)
  simpa only [AdjointableMap.adjoint_comp, interiorModuleTensorOperator_adjoint,
    AdjointableMap.adjoint_adjoint] using h

theorem tensorOperator_creationSandwich_commutator
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (T : AdjointableMap B E E)
    (S : AdjointableMap C F F) (x y : E) :
    interiorModuleTensorOperator φ T * creationSandwich φ S x y -
      creationSandwich φ S x y * interiorModuleTensorOperator φ T =
        creationSandwich φ S (T x) y - creationSandwich φ S x (T.adjoint y) := by
  have hl := moduleCreationMap_tensorOperator φ T x
  have hr := creationAdjoint_comp_tensorOperator φ T y
  change (interiorModuleTensorOperator φ T).comp (creationSandwich φ S x y) -
    (creationSandwich φ S x y).comp (interiorModuleTensorOperator φ T) =
      creationSandwich φ S (T x) y - creationSandwich φ S x (T.adjoint y)
  simp only [creationSandwich, ← AdjointableMap.comp_assoc, hl]
  rw [AdjointableMap.comp_assoc, AdjointableMap.comp_assoc, hr]

/-- Every actual first-factor tensor operator normalizes the concrete
first product algebra, independently of selfadjointness. -/
theorem tensorOperator_normalizes_firstProductAlgebra
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F)
    (T : AdjointableMap B E E) :
    ∀ a ∈ firstProductAlgebra φ S,
      interiorModuleTensorOperator φ T * a - a * interiorModuleTensorOperator φ T ∈
        firstProductAlgebra φ S := by
  have hbase (T : AdjointableMap B E E) : ∀ a ∈ firstProductGenerators φ S,
      interiorModuleTensorOperator φ T * a - a * interiorModuleTensorOperator φ T ∈
        firstProductAlgebra φ S := by
    intro a ha
    rcases ha with (ha | ha) | ha
    · obtain ⟨⟨x, y⟩, rfl⟩ := ha
      rw [tensorOperator_creationSandwich_commutator]
      exact (firstProductAlgebra φ S).sub_mem
        (creationSandwich_one_mem_firstProductAlgebra φ S _ _)
        (creationSandwich_one_mem_firstProductAlgebra φ S _ _)
    · obtain ⟨⟨x, y⟩, rfl⟩ := ha
      rw [tensorOperator_creationSandwich_commutator]
      exact (firstProductAlgebra φ S).sub_mem
        (creationSandwich_mem_firstProductAlgebra φ S _ _)
        (creationSandwich_mem_firstProductAlgebra φ S _ _)
    · exact moduleCompact_le_firstProductAlgebra φ S
        (IsModuleCompact.sub (mul_mem_moduleCompact_left _ ha)
          (mul_mem_moduleCompact_right ha _))
  apply normalizes_closedNonUnitalStarAdjoin _ _ (hbase T)
  simpa only [firstProductAlgebra, AdjointableMap.star_eq_adjoint,
    interiorModuleTensorOperator_adjoint] using hbase T.adjoint

end SandwichAlgebra

section ConnectionNormalizer
variable {Γ A B C E F : Type*} [Group Γ]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]
  [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul Bᵐᵒᵖ E] [CStarModule Bᵐᵒᵖ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [SMul Cᵐᵒᵖ F] [CStarModule Cᵐᵒᵖ F]
  [CompleteSpace E] [CompleteSpace F]
  {α : CStarAlgebraAction Γ A} {β : CStarAlgebraAction Γ B}
  {γ : CStarAlgebraAction Γ C}
  {δA : CStarGrading A} {δB : CStarGrading B} {δC : CStarGrading C}

namespace GradedKasparovConnection
variable {c : GradedKasparovCycle α β δA δB E} {d : GradedKasparovCycle β γ δB δC F}
  {G : AdjointableMap C (InteriorModuleTensor (E := E) d.representation)
    (InteriorModuleTensor (E := E) d.representation)} (hG : GradedKasparovConnection c d G)

include hG

/-- An actual selfadjoint connection normalizes the first sandwich family
modulo genuine compact operators; the leading terms are second sandwiches. -/
theorem commutator_creationSandwich_one_mem_firstProductAlgebra
    (hGsa : IsSelfAdjoint G) (hdsa : IsSelfAdjoint d.operator) (x y : E) :
    G * creationSandwich d.representation 1 x y -
      creationSandwich d.representation 1 x y * G ∈
        firstProductAlgebra d.representation d.operator := by
  let θ := moduleCreationMap (E := E) d.representation
  let D := fun z : E => G.comp (θ z) - (θ (c.grading.grading z)).comp d.operator
  have hDstar : (D y).adjoint = (θ y).adjoint.comp G -
      d.operator.comp (θ (c.grading.grading y)).adjoint := by
    change AdjointableMap.adjointContinuousLinearMap (D y) = _
    dsimp only [D]
    rw [map_sub]
    simp only [AdjointableMap.adjointContinuousLinearMap_apply,
      AdjointableMap.adjoint_comp]
    rw [show G.adjoint = G from hGsa.star_eq,
      show d.operator.adjoint = d.operator from hdsa.star_eq]
  have heq : G * creationSandwich d.representation 1 x y -
      creationSandwich d.representation 1 x y * G =
        creationSandwich d.representation d.operator (c.grading.grading x) y -
          creationSandwich d.representation d.operator x (c.grading.grading y) +
            (D x).comp (θ y).adjoint - (θ x).comp (D y).adjoint := by
    rw [hDstar]
    ext u
    simp only [creationSandwich, D, AdjointableMap.comp_apply,
      AdjointableMap.coe_sub_apply, AdjointableMap.coe_add_apply,
      AdjointableMap.mul_apply, AdjointableMap.one_apply, map_sub]
    abel
  rw [heq]
  let E₁ := firstProductAlgebra (E := E) d.representation d.operator
  have hlead := E₁.sub_mem
    (creationSandwich_mem_firstProductAlgebra d.representation d.operator (c.grading.grading x) y)
    (creationSandwich_mem_firstProductAlgebra d.representation d.operator x (c.grading.grading y))
  have hleft := moduleCompact_le_firstProductAlgebra (E := E) d.representation d.operator
    ((hG.creation_defect x).comp_right (θ y).adjoint)
  have hright := moduleCompact_le_firstProductAlgebra (E := E) d.representation d.operator
    ((hG.creation_defect y).adjoint.comp_left (θ x))
  exact E₁.sub_mem (E₁.add_mem hlead hleft) hright

/-- The second sandwich commutator reduces to the first family because
the actual localized second square defect is compact after creation.
The proof does not impose a global square defect on the second cycle. -/
theorem commutator_creationSandwich_mem_firstProductAlgebra
    (hGsa : IsSelfAdjoint G) (hdsa : IsSelfAdjoint d.operator) (x y : E) :
    G * creationSandwich d.representation d.operator x y -
      creationSandwich d.representation d.operator x y * G ∈
        firstProductAlgebra d.representation d.operator := by
  let θ := moduleCreationMap (E := E) d.representation
  let S := d.operator
  have hSsa : IsSelfAdjoint S := hdsa
  let D := fun z : E => G.comp (θ z) - (θ (c.grading.grading z)).comp S
  have hDstar : (D y).adjoint = (θ y).adjoint.comp G -
      S.comp (θ (c.grading.grading y)).adjoint := by
    change AdjointableMap.adjointContinuousLinearMap (D y) = _
    dsimp only [D]
    rw [map_sub]
    simp only [AdjointableMap.adjointContinuousLinearMap_apply,
      AdjointableMap.adjoint_comp]
    rw [show G.adjoint = G from hGsa.star_eq,
      show S.adjoint = S from hdsa.star_eq]
  have hSstar : star (S * S - 1) = S * S - 1 := by
    simp only [star_sub, star_mul, star_one, hSsa.star_eq]
  have hsquare (z : E) : IsModuleCompact ((θ z).comp (S * S - 1)) :=
    moduleCreationMap_comp_isModuleCompact_of_local d.representation z (S * S - 1)
      d.square_mod_compact (fun b => by simpa only [hSstar] using d.square_mod_compact b)
  have heq : G * creationSandwich d.representation S x y -
      creationSandwich d.representation S x y * G =
        creationSandwich d.representation 1 (c.grading.grading x) y -
          creationSandwich d.representation 1 x (c.grading.grading y) +
            ((D x).comp S).comp (θ y).adjoint -
              ((θ x).comp S).comp (D y).adjoint +
                ((θ (c.grading.grading x)).comp (S * S - 1)).comp (θ y).adjoint -
                  ((θ x).comp (S * S - 1)).comp (θ (c.grading.grading y)).adjoint := by
    rw [hDstar]
    ext u
    simp only [creationSandwich, D, AdjointableMap.comp_apply,
      AdjointableMap.coe_sub_apply, AdjointableMap.coe_add_apply,
      AdjointableMap.mul_apply, AdjointableMap.one_apply, map_sub]
    abel
  rw [heq]
  let E₁ := firstProductAlgebra (E := E) d.representation S
  have hlead := E₁.sub_mem
    (creationSandwich_one_mem_firstProductAlgebra d.representation S (c.grading.grading x) y)
    (creationSandwich_one_mem_firstProductAlgebra d.representation S x (c.grading.grading y))
  have hleft := moduleCompact_le_firstProductAlgebra (E := E) d.representation S
    (((hG.creation_defect x).comp_right S).comp_right (θ y).adjoint)
  have hright := moduleCompact_le_firstProductAlgebra (E := E) d.representation S
    ((hG.creation_defect y).adjoint.comp_left ((θ x).comp S))
  have hsqleft := moduleCompact_le_firstProductAlgebra (E := E) d.representation S
    ((hsquare (c.grading.grading x)).comp_right (θ y).adjoint)
  have hsqright := moduleCompact_le_firstProductAlgebra (E := E) d.representation S
    ((hsquare x).comp_right (θ (c.grading.grading y)).adjoint)
  exact E₁.sub_mem (E₁.add_mem (E₁.sub_mem (E₁.add_mem hlead hleft) hright) hsqleft) hsqright

/-- The genuine selfadjoint frame connection normalizes the whole actual
first algebra, using the two distinct sandwich families and compact ideal. -/
theorem normalizes_firstProductAlgebra (hGsa : IsSelfAdjoint G)
    (hdsa : IsSelfAdjoint d.operator) :
    ∀ a ∈ firstProductAlgebra d.representation d.operator,
      G * a - a * G ∈ firstProductAlgebra d.representation d.operator := by
  have hbase : ∀ a ∈ firstProductGenerators d.representation d.operator,
      G * a - a * G ∈ firstProductAlgebra d.representation d.operator := by
    intro a ha
    rcases ha with (ha | ha) | ha
    · obtain ⟨⟨x, y⟩, rfl⟩ := ha
      exact hG.commutator_creationSandwich_one_mem_firstProductAlgebra hGsa hdsa x y
    · obtain ⟨⟨x, y⟩, rfl⟩ := ha
      exact hG.commutator_creationSandwich_mem_firstProductAlgebra hGsa hdsa x y
    · exact moduleCompact_le_firstProductAlgebra d.representation d.operator
        (IsModuleCompact.sub (mul_mem_moduleCompact_left G ha)
          (mul_mem_moduleCompact_right ha G))
  apply normalizes_closedNonUnitalStarAdjoin _ G hbase
  simpa only [firstProductAlgebra, hGsa.star_eq] using hbase

end GradedKasparovConnection
end ConnectionNormalizer

section RectangularGrading
variable {C H K L : Type*} [NonUnitalCStarAlgebra C]
  [PartialOrder C] [StarOrderedRing C]
  [NormedAddCommGroup H] [NormedSpace ℂ H] [SMul Cᵐᵒᵖ H] [CStarModule Cᵐᵒᵖ H]
  [NormedAddCommGroup K] [NormedSpace ℂ K] [SMul Cᵐᵒᵖ K] [CStarModule Cᵐᵒᵖ K]
  [NormedAddCommGroup L] [NormedSpace ℂ L] [SMul Cᵐᵒᵖ L] [CStarModule Cᵐᵒᵖ L]
  {δ : CStarGrading C}

namespace GradedHilbertModule

/-- Rectangular transport by two genuine semilinear module gradings.
The gradings themselves are not assumed coefficient-linear. -/
def conjugateRectangular (J : GradedHilbertModule δ H) (M : GradedHilbertModule δ K)
    (T : AdjointableMap C H K) : AdjointableMap C H K where
  toCLM := M.grading.toContinuousLinearEquiv.toContinuousLinearMap.comp
    (T.toCLM.comp J.grading.toContinuousLinearEquiv.toContinuousLinearMap)
  adjointCLM := J.grading.toContinuousLinearEquiv.toContinuousLinearMap.comp
    (T.adjointCLM.comp M.grading.toContinuousLinearEquiv.toContinuousLinearMap)
  adjoint_identity x y := by
    change ⟪M.grading (T (J.grading x)), y⟫_(Cᵐᵒᵖ) =
      ⟪x, J.grading (T.adjointCLM (M.grading y))⟫_(Cᵐᵒᵖ)
    rw [M.inner_grading_left, T.adjoint_identity, J.inner_grading_left,
      CStarGrading.op_automorphism_sq]

@[simp] theorem conjugateRectangular_apply
    (J : GradedHilbertModule δ H) (M : GradedHilbertModule δ K)
    (T : AdjointableMap C H K) (x : H) :
    J.conjugateRectangular M T x = M.grading (T (J.grading x)) := by
  let _retainedOriginalStarOrder : StarOrderedRing C := inferInstance
  rfl

@[simp] theorem conjugateRectangular_adjoint
    (J : GradedHilbertModule δ H) (M : GradedHilbertModule δ K)
    (T : AdjointableMap C H K) :
    (J.conjugateRectangular M T).adjoint = M.conjugateRectangular J T.adjoint := by
  let _retainedOriginalStarOrder : StarOrderedRing C := inferInstance
  rfl

theorem conjugateRectangular_comp
    (J : GradedHilbertModule δ H) (M : GradedHilbertModule δ K)
    (N : GradedHilbertModule δ L) (S : AdjointableMap C K L) (T : AdjointableMap C H K) :
    J.conjugateRectangular N (S.comp T) =
      (M.conjugateRectangular N S).comp (J.conjugateRectangular M T) := by
  let _retainedOriginalStarOrder : StarOrderedRing C := inferInstance
  ext x
  simp only [conjugateRectangular_apply, AdjointableMap.comp_apply, M.grading_sq]

def conjugateRectangularCLM (J : GradedHilbertModule δ H) (M : GradedHilbertModule δ K) :
    AdjointableMap C H K →L[ℂ] AdjointableMap C H K :=
  LinearMap.mkContinuous
    { toFun := J.conjugateRectangular M
      map_add' := fun S T => by
        ext x
        simp only [conjugateRectangular_apply, AdjointableMap.coe_add_apply, map_add]
      map_smul' := fun c T => by
        ext x
        simp only [conjugateRectangular_apply, AdjointableMap.coe_smul_apply, map_smul,
          RingHom.id_apply] }
    1 (fun T => by
      rw [AdjointableMap.norm_def, one_mul]
      apply ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg T.toCLM)
      intro x
      change ‖M.grading (T (J.grading x))‖ ≤ ‖T.toCLM‖ * ‖x‖
      rw [M.grading.norm_map]
      simpa only [J.grading.norm_map] using T.toCLM.le_opNorm (J.grading x))

theorem conjugateRectangular_rankOne
    (J : GradedHilbertModule δ H) (M : GradedHilbertModule δ K) (x : K) (y : H) :
    J.conjugateRectangular M (moduleRankOne x y) =
      moduleRankOne (M.grading x) (J.grading y) := by
  ext z
  simp only [conjugateRectangular_apply, moduleRankOne_apply, M.map_op_smul]
  rw [← J.inner_grading_left]

/-- Rectangular grading transport preserves the genuine compact maps
through their rank-one span and norm closure. -/
theorem conjugateRectangular_mem_moduleCompact
    (J : GradedHilbertModule δ H) (M : GradedHilbertModule δ K)
    {T : AdjointableMap C H K} (hT : IsModuleCompact T) :
    IsModuleCompact (J.conjugateRectangular M T) := by
  let Q := (moduleCompact C H K).comap (J.conjugateRectangularCLM M).toLinearMap
  have hQ : IsClosed (Q : Set (AdjointableMap C H K)) :=
    moduleCompact_isClosed.preimage (J.conjugateRectangularCLM M).continuous
  have hθ (x : K) (y : H) : moduleRankOne x y ∈ Q := by
    change IsModuleCompact (J.conjugateRectangular M (moduleRankOne x y))
    rw [conjugateRectangular_rankOne]
    exact moduleRankOne_mem_moduleCompact _ _
  exact moduleCompact_le_of_isClosed Q hQ hθ hT

end GradedHilbertModule
end RectangularGrading

section TensorTransport
variable {Γ B C E F : Type*} [Group Γ]
  [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]
  [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul Bᵐᵒᵖ E] [CStarModule Bᵐᵒᵖ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [SMul Cᵐᵒᵖ F] [CStarModule Cᵐᵒᵖ F]
  [CompleteSpace E] [CompleteSpace F]
  {δB : CStarGrading B} {δC : CStarGrading C}
  {β : CStarAlgebraAction Γ B} {γ : CStarAlgebraAction Γ C}

theorem gradingConjugateRectangular_moduleCreationMap
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (J : GradedHilbertModule δB E) (K : GradedHilbertModule δC F)
    (hφ : ModuleTensorRepresentationGraded (δB := δB) φ K) (x : E) :
    K.conjugateRectangular (J.interiorTensor K hφ) (moduleCreationMap φ x) =
      moduleCreationMap φ (J.grading x) := by
  ext y
  change (J.interiorTensor K hφ).grading
      (interiorModuleTensorMk φ x (K.grading y)) = interiorModuleTensorMk φ (J.grading x) y
  rw [GradedHilbertModule.interiorTensor_grading_mk, K.grading_sq]

/-- The genuine tensor grading transports both vectors and the genuine
second-factor operator in an actual creation sandwich. -/
theorem gradingConjugate_creationSandwich
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (J : GradedHilbertModule δB E) (K : GradedHilbertModule δC F)
    (hφ : ModuleTensorRepresentationGraded (δB := δB) φ K)
    (S : AdjointableMap C F F) (x y : E) :
    (J.interiorTensor K hφ).conjugateOperator (creationSandwich φ S x y) =
      creationSandwich φ (K.conjugateOperator S) (J.grading x) (J.grading y) := by
  let Q := J.interiorTensor K hφ
  change Q.conjugateRectangular Q (creationSandwich φ S x y) = _
  change Q.conjugateRectangular Q
    (((moduleCreationMap φ x).comp S).comp (moduleCreationMap φ y).adjoint) = _
  rw [GradedHilbertModule.conjugateRectangular_comp Q K Q,
    GradedHilbertModule.conjugateRectangular_comp K K Q,
    ← GradedHilbertModule.conjugateRectangular_adjoint K Q,
    gradingConjugateRectangular_moduleCreationMap φ J K hφ x,
    gradingConjugateRectangular_moduleCreationMap φ J K hφ y]
  rfl

theorem actionConjugate_creationSandwich
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (U : EquivariantHilbertModule β E) (V : EquivariantHilbertModule γ F)
    (hφ : ModuleTensorRepresentationEquivariant φ β V)
    (S : AdjointableMap C F F) (g : Γ) (x y : E) :
    (U.interiorTensor V hφ).conjugateOperator g (creationSandwich φ S x y) =
      creationSandwich φ (V.conjugateOperator g S) (U.action g x) (U.action g y) := by
  let Q := U.interiorTensor V hφ
  change Q.conjugateMap Q g (creationSandwich φ S x y) = _
  change Q.conjugateMap Q g
    (((moduleCreationMap φ x).comp S).comp (moduleCreationMap φ y).adjoint) = _
  rw [EquivariantHilbertModule.conjugateMap_comp Q V Q g,
    EquivariantHilbertModule.conjugateMap_comp V V Q g,
    ← EquivariantHilbertModule.conjugateMap_adjoint V Q g,
    conjugateMap_moduleCreationMap φ U V hφ g x,
    conjugateMap_moduleCreationMap φ U V hφ g y]
  rfl

/-- Grading stability of the actual first algebra follows from genuine
oddness of the second operator and transport of the two sandwich families. -/
theorem grading_preserves_firstProductAlgebra
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (J : GradedHilbertModule δB E) (K : GradedHilbertModule δC F)
    (hφ : ModuleTensorRepresentationGraded (δB := δB) φ K)
    (S : AdjointableMap C F F) (hS : K.IsOdd K S) :
    ∀ a ∈ firstProductAlgebra φ S,
      (J.interiorTensor K hφ).conjugateOperator a ∈ firstProductAlgebra φ S := by
  let Q := J.interiorTensor K hφ
  have hSgrade : K.conjugateOperator S = -S := by
    ext y
    simp only [GradedHilbertModule.conjugateOperator_apply, AdjointableMap.coe_neg_apply]
    rw [hS (K.grading y), K.grading_sq]
  apply maps_closedNonUnitalStarAdjoin _ Q.conjugateOperatorStarAlgEquiv
  intro a ha
  rcases ha with (ha | ha) | ha
  · obtain ⟨⟨x, y⟩, rfl⟩ := ha
    change Q.conjugateOperator (creationSandwich φ 1 x y) ∈ _
    rw [gradingConjugate_creationSandwich]
    have h1 : K.conjugateOperator (1 : AdjointableMap C F F) = 1 := by
      ext z
      simp only [GradedHilbertModule.conjugateOperator_apply, AdjointableMap.one_apply,
        K.grading_sq]
    rw [h1]
    exact creationSandwich_one_mem_firstProductAlgebra φ S _ _
  · obtain ⟨⟨x, y⟩, rfl⟩ := ha
    change Q.conjugateOperator (creationSandwich φ S x y) ∈ _
    rw [gradingConjugate_creationSandwich, hSgrade]
    have heq : creationSandwich φ (-S) (J.grading x) (J.grading y) =
        -creationSandwich φ S (J.grading x) (J.grading y) := by
      ext u
      simp only [creationSandwich, AdjointableMap.comp_apply, AdjointableMap.coe_neg_apply,
        map_neg]
    rw [heq]
    exact (firstProductAlgebra φ S).neg_mem (creationSandwich_mem_firstProductAlgebra φ S _ _)
  · exact moduleCompact_le_firstProductAlgebra φ S (Q.conjugateOperator_mem_moduleCompact ha)

/-- The creation-local containing algebra is stable under the actual
tensor grading, including its rectangular adjoint condition. -/
theorem grading_preserves_creationLocallyCompactAlgebra
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (J : GradedHilbertModule δB E) (K : GradedHilbertModule δC F)
    (hφ : ModuleTensorRepresentationGraded (δB := δB) φ K)
    {T : AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ)}
    (hT : IsCreationLocallyCompact φ T) :
    IsCreationLocallyCompact φ ((J.interiorTensor K hφ).conjugateOperator T) := by
  let Q := J.interiorTensor K hφ
  have hcomp (T : AdjointableMap C (InteriorModuleTensor (E := E) φ)
      (InteriorModuleTensor (E := E) φ)) (x : E) :
      (Q.conjugateOperator T).comp (moduleCreationMap φ x) =
        K.conjugateRectangular Q (T.comp (moduleCreationMap φ (J.grading x))) := by
    rw [GradedHilbertModule.conjugateRectangular_comp,
      gradingConjugateRectangular_moduleCreationMap, J.grading_sq]
    rfl
  intro x
  constructor
  · rw [hcomp]
    exact K.conjugateRectangular_mem_moduleCompact Q (hT _).1
  · change IsModuleCompact ((Q.conjugateOperator T.adjoint).comp (moduleCreationMap φ x))
    rw [hcomp]
    exact K.conjugateRectangular_mem_moduleCompact Q (hT _).2

end TensorTransport

section TensorApproximateUnit
variable {B C E F : Type*} [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]
  [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul Bᵐᵒᵖ E] [CStarModule Bᵐᵒᵖ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [SMul Cᵐᵒᵖ F] [CStarModule Cᵐᵒᵖ F]
  [CompleteSpace E] [CompleteSpace F]

local instance kasparovProductAlgebrasLocalInstance1 : PartialOrder (AdjointableMap B E E) := CStarAlgebra.spectralOrder _
local instance kasparovProductAlgebrasLocalInstance2 : StarOrderedRing (AdjointableMap B E E) := CStarAlgebra.spectralOrderedRing _

/-- Creation sandwiches depend continuously in operator norm on their
first vector, by actual bounded rectangular composition. -/
def creationSandwichFirstCLM (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F)
    (S : AdjointableMap C F F) (y : E) :
    E →L[ℂ] AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ) :=
  (AdjointableMap.compRightContinuousLinearMap (moduleCreationMap φ y).adjoint).comp
    ((AdjointableMap.compRightContinuousLinearMap S).comp (moduleCreationContinuousLinearMap φ))

/-- A strongly convergent first-factor contraction sequence genuinely
converges strongly on the completed interior tensor. -/
theorem tensorOperator_tendsto_apply_of_strong_contractions
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (q : ℕ → AdjointableMap B E E)
    (hqnorm : ∀ n, ‖q n‖ ≤ 1)
    (hqstrong : ∀ x, Tendsto (fun n => q n x) atTop (𝓝 x))
    (u : InteriorModuleTensor (E := E) φ) :
    Tendsto (fun n => interiorModuleTensorOperator φ (q n) u) atTop (𝓝 u) := by
  let Q := strongConvergenceSubmodule (l := atTop)
    (fun n => (interiorModuleTensorOperator φ (q n)).toCLM)
    (ContinuousLinearMap.id ℂ (InteriorModuleTensor (E := E) φ))
  have hQ : IsClosed (Q : Set (InteriorModuleTensor (E := E) φ)) :=
    strongConvergenceSubmodule_isClosed _ _ 1 zero_le_one
      (Eventually.of_forall fun n => (interiorModuleTensorOperator_norm_le φ (q n)).trans (hqnorm n))
  have hpure (x : E) (y : F) : interiorModuleTensorMk φ x y ∈ Q := by
    have hcont : Continuous (fun z : E => interiorModuleTensorMk φ z y) := by
      change Continuous (fun z : E => (moduleCreationMap φ z).toCLM y)
      exact (AdjointableMap.toCLMContinuousLinearMap.continuous.comp
        (moduleCreationContinuousLinearMap φ).continuous).clm_apply continuous_const
    change Tendsto (fun n => interiorModuleTensorOperator φ (q n)
      (interiorModuleTensorMk φ x y)) atTop (𝓝 (interiorModuleTensorMk φ x y))
    simpa only [interiorModuleTensorOperator_mk, Function.comp_def]
      using (hcont.tendsto x).comp (hqstrong x)
  have hspan : Submodule.span ℂ (Set.range fun p : E × F => interiorModuleTensorMk φ p.1 p.2) ≤ Q :=
    Submodule.span_le.mpr (by rintro _ ⟨⟨x, y⟩, rfl⟩; exact hpure x y)
  exact (interiorModuleTensor_span_dense φ).induction (fun _ hu => hspan hu) hQ u

/-- The tensor sequence approximates either sandwich family in norm,
on both sides, from the genuine first-vector strong approximation. -/
theorem tensorOperator_tendsto_creationSandwich
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (q : ℕ → AdjointableMap B E E)
    (hqself : ∀ n, (q n).adjoint = q n)
    (hqstrong : ∀ x, Tendsto (fun n => q n x) atTop (𝓝 x))
    (S : AdjointableMap C F F) (x y : E) :
    Tendsto (fun n => interiorModuleTensorOperator φ (q n) * creationSandwich φ S x y)
      atTop (𝓝 (creationSandwich φ S x y)) ∧
    Tendsto (fun n => creationSandwich φ S x y * interiorModuleTensorOperator φ (q n))
      atTop (𝓝 (creationSandwich φ S x y)) := by
  have hleft (S : AdjointableMap C F F) (x y : E) :
      Tendsto (fun n => interiorModuleTensorOperator φ (q n) * creationSandwich φ S x y)
        atTop (𝓝 (creationSandwich φ S x y)) := by
    have heq (n : ℕ) : interiorModuleTensorOperator φ (q n) * creationSandwich φ S x y =
        creationSandwich φ S (q n x) y := by
      dsimp only [creationSandwich]
      change (interiorModuleTensorOperator φ (q n)).comp _ = _
      rw [← AdjointableMap.comp_assoc, ← AdjointableMap.comp_assoc,
        moduleCreationMap_tensorOperator]
    simp_rw [heq]
    exact ((creationSandwichFirstCLM φ S y).continuous.tendsto x).comp (hqstrong x)
  refine ⟨hleft S x y, ?_⟩
  have h := (AdjointableMap.adjointContinuousLinearMap.continuous.tendsto
    (creationSandwich φ S.adjoint y x)).comp (hleft S.adjoint y x)
  have hadjmul (T U : AdjointableMap C (InteriorModuleTensor (E := E) φ)
      (InteriorModuleTensor (E := E) φ)) : (T * U).adjoint = U.adjoint * T.adjoint :=
    star_mul T U
  simpa only [Function.comp_def, AdjointableMap.adjointContinuousLinearMap_apply,
    hadjmul, interiorModuleTensorOperator_adjoint, hqself,
    creationSandwich_adjoint, AdjointableMap.adjoint_adjoint] using h

/-- The actual first compact AU, tensored with one, is a two-sided norm
AU of the concrete closed first algebra. Compact tensor operators are
handled by genuine strong-to-compact norm convergence. -/
theorem firstProductAlgebra_tendsto_tensorApproximateUnit
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F)
    (q : ℕ → AdjointableMap B E E) (hqnorm : ∀ n, ‖q n‖ ≤ 1)
    (hqself : ∀ n, (q n).adjoint = q n)
    (hqstrong : ∀ x, Tendsto (fun n => q n x) atTop (𝓝 x)) :
    ∀ a ∈ firstProductAlgebra φ S,
      Tendsto (fun n => interiorModuleTensorOperator φ (q n) * a) atTop (𝓝 a) ∧
        Tendsto (fun n => a * interiorModuleTensorOperator φ (q n)) atTop (𝓝 a) := by
  let u := fun n => interiorModuleTensorOperator φ (q n)
  have hunorm (n : ℕ) : ‖u n‖ ≤ 1 := (interiorModuleTensorOperator_norm_le φ (q n)).trans (hqnorm n)
  have huself (n : ℕ) : (u n).adjoint = u n := by
    rw [interiorModuleTensorOperator_adjoint, hqself]
  have hustar (n : ℕ) : star (u n) = u n := huself n
  have hustrong := tensorOperator_tendsto_apply_of_strong_contractions φ q hqnorm hqstrong
  let Q := approximateUnitConvergenceAlgebra u hustar
  have hle : firstProductAlgebra φ S ≤ Q := by
    apply closedNonUnitalStarAdjoin_le _ Q
      (approximateUnitConvergenceAlgebra_isClosed u hustar hunorm)
    intro a ha
    rcases ha with (ha | ha) | ha
    · obtain ⟨⟨x, y⟩, rfl⟩ := ha
      exact tensorOperator_tendsto_creationSandwich φ q hqself hqstrong 1 x y
    · obtain ⟨⟨x, y⟩, rfl⟩ := ha
      exact tensorOperator_tendsto_creationSandwich φ q hqself hqstrong S x y
    · exact ⟨isModuleCompact_tendsto_comp_left_of_strong_contractions u hunorm hustrong ha,
        isModuleCompact_tendsto_comp_right_of_strong_selfadjoint_contractions u hunorm huself hustrong ha⟩
  exact fun _ ha => hle ha

/-- The first algebra's countable AU is constructed from countable first
module generation over its separable coefficient algebra. -/
theorem exists_firstProductAlgebra_approximateUnit [TopologicalSpace.SeparableSpace B]
    (φ : B →⋆ₙₐ[ℂ] AdjointableMap C F F) (S : AdjointableMap C F F)
    (hE : IsCountablyGeneratedModule B E) :
    ∃ q : ℕ → firstProductAlgebra (E := E) φ S,
      (∀ a : firstProductAlgebra (E := E) φ S, Tendsto (fun n => a * q n) atTop (𝓝 a)) ∧
        (∀ a : firstProductAlgebra (E := E) φ S, Tendsto (fun n => q n * a) atTop (𝓝 a)) := by
  let : IsClosed ((firstProductAlgebra (E := E) φ S) :
      Set (AdjointableMap C (InteriorModuleTensor (E := E) φ) (InteriorModuleTensor (E := E) φ))) :=
    firstProductAlgebra_isClosed (E := E) φ S
  obtain ⟨e, _, _, _, he1, _, _, hestrong⟩ :=
    exists_countablyGenerated_compact_approximateUnit hE
  let q : ℕ → firstProductAlgebra (E := E) φ S := fun n =>
    ⟨interiorModuleTensorOperator φ (e n : AdjointableMap B E E),
      tensorCompact_mem_firstProductAlgebra φ S (e n).property⟩
  have heself (n : ℕ) : (e n : AdjointableMap B E E).adjoint = e n :=
    (hestrong.nonneg n).isSelfAdjoint.star_eq
  have hlim := firstProductAlgebra_tendsto_tensorApproximateUnit φ S
    (fun n => (e n : AdjointableMap B E E)) he1 heself hestrong.strong
  refine ⟨q, ?_, ?_⟩
  · intro a
    exact tendsto_subtype_rng.mpr (hlim a a.property).2
  · intro a
    exact tendsto_subtype_rng.mpr (hlim a a.property).1

end TensorApproximateUnit

section SeparableAdjoin
variable {D : Type*} [CStarAlgebra D]

/-- A countable set generates a separable actual star algebra: finite
multiplicative words are countable and their complex span is separable. -/
theorem closedNonUnitalStarAdjoin_isSeparable_of_countable (s : Set D)
    (hs : s.Countable) : TopologicalSpace.IsSeparable (closedNonUnitalStarAdjoin s : Set D) := by
  classical
  have ht : (s ∪ star s).Countable := hs.union (by
    rw [← Set.image_star]
    exact hs.image star)
  let t : Set D := s ∪ star s
  have ht' : t.Countable := ht
  let : Countable t := ht'.to_subtype
  let w : List t → D := fun l => (l.map (fun x => x.val)).prod
  have hwords : (Subsemigroup.closure t : Set D) ⊆ Set.range w := by
    intro a ha
    induction ha using Subsemigroup.closure_induction with
    | mem a ha => exact ⟨[⟨a, ha⟩], by simp [w]⟩
    | mul a b ha hb hwa hwb =>
      obtain ⟨la, rfl⟩ := hwa
      obtain ⟨lb, rfl⟩ := hwb
      exact ⟨la ++ lb, by simp [w, List.prod_append]⟩
  have hcount : (Subsemigroup.closure t : Set D).Countable :=
    (Set.countable_range w).mono hwords
  have hadjoin : TopologicalSpace.IsSeparable (NonUnitalStarAlgebra.adjoin ℂ s : Set D) := by
    change TopologicalSpace.IsSeparable
      ((NonUnitalStarAlgebra.adjoin ℂ s).toSubmodule : Set D)
    rw [NonUnitalStarAlgebra.adjoin_eq_span]
    exact hcount.isSeparable.span (R := ℂ)
  exact hadjoin.closure

/-- Norm-separable generator sets generate a separable actual closed
star algebra, by first taking a genuine countable dense subset of them. -/
theorem closedNonUnitalStarAdjoin_isSeparable (s : Set D)
    (hs : TopologicalSpace.IsSeparable s) :
    TopologicalSpace.IsSeparable (closedNonUnitalStarAdjoin s : Set D) := by
  let : TopologicalSpace.SeparableSpace s := hs.separableSpace
  obtain ⟨c, hc, hcdense⟩ := TopologicalSpace.exists_countable_dense s
  let q : Set D := Subtype.val '' c
  have hqcount : q.Countable := hc.image Subtype.val
  have hsclosure : s ⊆ closure q := by
    intro a ha
    exact map_mem_closure continuous_subtype_val (hcdense ⟨a, ha⟩)
      (fun z hz => ⟨z, hz, rfl⟩)
  have hle : closedNonUnitalStarAdjoin s ≤ closedNonUnitalStarAdjoin q :=
    closedNonUnitalStarAdjoin_le s _ (closedNonUnitalStarAdjoin_isClosed q)
      (hsclosure.trans (closure_minimal (subset_closedNonUnitalStarAdjoin q)
        (closedNonUnitalStarAdjoin_isClosed q)))
  exact (closedNonUnitalStarAdjoin_isSeparable_of_countable q hqcount).mono hle

end SeparableAdjoin

section CycleAction
variable {Γ A B C E F : Type*} [Group Γ]
  [NonUnitalCStarAlgebra A] [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]
  [NormedAddCommGroup E] [NormedSpace ℂ E] [SMul Bᵐᵒᵖ E] [CStarModule Bᵐᵒᵖ E]
  [NormedAddCommGroup F] [NormedSpace ℂ F] [SMul Cᵐᵒᵖ F] [CStarModule Cᵐᵒᵖ F]
  [CompleteSpace E] [CompleteSpace F]
  {α : CStarAlgebraAction Γ A} {β : CStarAlgebraAction Γ B}
  {γ : CStarAlgebraAction Γ C}
  {δA : CStarGrading A} {δB : CStarGrading B} {δC : CStarGrading C}

/-- The actual tensor group action preserves the concrete first algebra.
For second sandwiches, localized equivariance of the second operator
gives the compact correction to its genuine transported sandwich. -/
theorem action_preserves_firstProductAlgebra
    (c : GradedKasparovCycle α β δA δB E) (d : GradedKasparovCycle β γ δB δC F)
    (hdsa : IsSelfAdjoint d.operator) (g : Γ) :
    ∀ a ∈ firstProductAlgebra d.representation d.operator,
      (gradedKasparovTensorAction c d).conjugateOperator g a ∈
        firstProductAlgebra d.representation d.operator := by
  let Q := gradedKasparovTensorAction c d
  let Sg := d.groupAction.conjugateOperator g d.operator - d.operator
  have hSgsa : IsSelfAdjoint Sg := by
    change star (d.groupAction.conjugateOperator g d.operator - d.operator) = _
    simp only [star_sub, AdjointableMap.star_eq_adjoint,
      EquivariantHilbertModule.conjugateMap_adjoint]
    change d.groupAction.conjugateOperator g (star d.operator) - star d.operator = _
    rw [hdsa.star_eq]
  have hSg (x : E) : IsModuleCompact ((moduleCreationMap d.representation x).comp Sg) :=
    moduleCreationMap_comp_isModuleCompact_of_local d.representation x Sg
      (d.equivariance_mod_compact g)
      (fun b => by simpa only [← AdjointableMap.star_eq_adjoint, hSgsa.star_eq]
        using d.equivariance_mod_compact g b)
  apply maps_closedNonUnitalStarAdjoin _ (Q.conjugateOperatorStarAlgEquiv g)
  intro a ha
  rcases ha with (ha | ha) | ha
  · obtain ⟨⟨x, y⟩, rfl⟩ := ha
    change (c.groupAction.interiorTensor d.groupAction
      (d.groupAction.representationEquivariant_of_conjugate d.representation_equivariant)).conjugateOperator g
      (creationSandwich d.representation 1 x y) ∈ firstProductAlgebra d.representation d.operator
    rw [actionConjugate_creationSandwich]
    have hid : d.groupAction.conjugateOperator g (1 : AdjointableMap C F F) = 1 := by
      change d.groupAction.conjugateOperator g (AdjointableMap.id : AdjointableMap C F F) =
        AdjointableMap.id
      exact EquivariantHilbertModule.conjugateOperator_id d.groupAction g
    rw [hid]
    exact creationSandwich_one_mem_firstProductAlgebra d.representation d.operator _ _
  · obtain ⟨⟨x, y⟩, rfl⟩ := ha
    change (c.groupAction.interiorTensor d.groupAction
      (d.groupAction.representationEquivariant_of_conjugate d.representation_equivariant)).conjugateOperator g
      (creationSandwich d.representation d.operator x y) ∈ firstProductAlgebra d.representation d.operator
    rw [actionConjugate_creationSandwich]
    have heq : creationSandwich d.representation (d.groupAction.conjugateOperator g d.operator)
        (c.groupAction.action g x) (c.groupAction.action g y) =
        creationSandwich d.representation d.operator (c.groupAction.action g x) (c.groupAction.action g y) +
          creationSandwich d.representation Sg (c.groupAction.action g x) (c.groupAction.action g y) := by
      ext u
      simp only [creationSandwich, Sg, AdjointableMap.comp_apply,
        AdjointableMap.coe_add_apply, AdjointableMap.coe_sub_apply, map_sub]
      abel
    rw [heq]
    exact (firstProductAlgebra d.representation d.operator).add_mem
      (creationSandwich_mem_firstProductAlgebra d.representation d.operator _ _)
      (moduleCompact_le_firstProductAlgebra d.representation d.operator
        ((hSg _).comp_right (moduleCreationMap d.representation (c.groupAction.action g y)).adjoint))
  · exact moduleCompact_le_firstProductAlgebra d.representation d.operator
      (Q.conjugateOperator_mem_moduleCompact g ha)

end CycleAction
