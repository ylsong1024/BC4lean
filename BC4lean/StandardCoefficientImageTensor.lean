import BC4lean.CoefficientImageRightModule
import BC4lean.StandardModuleTensor
import BC4lean.ModuleTensorOperator

/-! # The standard tensor is the actual coefficient image module

For an arbitrary nonunital coefficient homomorphism f, the completed tensor
B_B ⊗f C_C is unitarily equivalent to the closed right module generated by
f(B)C. This uses the verified essential-range construction and preserves the
entire coefficient form. No surjectivity onto C or complementary projection
is assumed. Actual first-factor left multiplication intertwines with left
f(b) on this image module.
-/

noncomputable section
namespace BC4lean.KKTheory
open scoped InnerProductSpace

variable {B C : Type*} [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]

def standardCoefficientImageRepresentation (f : B →⋆ₙₐ[ℂ] C) :
    B →⋆ₙₐ[ℂ] AdjointableMap C Cᵐᵒᵖ Cᵐᵒᵖ :=
  (standardLeftMul (B := C)).comp f

omit [PartialOrder B] [StarOrderedRing B] in
theorem coefficientImageEssentialRange_eq (f : B →⋆ₙₐ[ℂ] C) :
    moduleEssentialRange (standardCoefficientImageRepresentation f) =
      coefficientImageClosedSubmodule f := by
  have h : (Set.range fun p : B × Cᵐᵒᵖ =>
      standardCoefficientImageRepresentation f p.1 p.2) = coefficientImageProducts f := by
    ext x
    constructor
    · rintro ⟨⟨b, c⟩, rfl⟩
      exact ⟨(b, MulOpposite.unop c), rfl⟩
    · rintro ⟨⟨b, c⟩, rfl⟩
      exact ⟨(b, MulOpposite.op c), rfl⟩
  unfold moduleEssentialRange coefficientImageClosedSubmodule coefficientImageSpan
  rw [h]

/-- A concrete unitary between the two descriptions of the same right submodule. -/
def coefficientImageEssentialEquiv (f : B →⋆ₙₐ[ℂ] C) :
    HilbertModuleEquiv C (moduleEssentialRange (standardCoefficientImageRepresentation f))
      (CoefficientImageRightModule f) where
  linearIsometryEquiv :=
    { toLinearEquiv :=
        { toFun x := ⟨(x : Cᵐᵒᵖ), by
            change (x : Cᵐᵒᵖ) ∈ coefficientImageClosedSubmodule f
            rw [← coefficientImageEssentialRange_eq f]
            exact x.property⟩
          invFun x := ⟨(x : Cᵐᵒᵖ), by
            rw [coefficientImageEssentialRange_eq f]
            exact x.property⟩
          left_inv _ := rfl
          right_inv _ := rfl
          map_add' _ _ := rfl
          map_smul' _ _ := rfl }
      norm_map' _ := rfl }
  inner_map _ _ := rfl

@[simp] theorem coefficientImageEssentialEquiv_coe (f : B →⋆ₙₐ[ℂ] C)
    (x : moduleEssentialRange (standardCoefficientImageRepresentation f)) :
    (coefficientImageEssentialEquiv f x : Cᵐᵒᵖ) = (x : Cᵐᵒᵖ) := rfl

/-- The genuine completed standard tensor image unitary for arbitrary f. -/
def standardCoefficientImageTensorEquiv (f : B →⋆ₙₐ[ℂ] C) :
    HilbertModuleEquiv C
      (InteriorModuleTensor (E := Bᵐᵒᵖ) (standardCoefficientImageRepresentation f))
      (CoefficientImageRightModule f) :=
  (standardInteriorModuleTensorHilbertEquiv (standardCoefficientImageRepresentation f)).trans
    (coefficientImageEssentialEquiv f)

@[simp] theorem standardCoefficientImageTensorEquiv_mk (f : B →⋆ₙₐ[ℂ] C)
    (x : Bᵐᵒᵖ) (y : Cᵐᵒᵖ) :
    (standardCoefficientImageTensorEquiv f
      (interiorModuleTensorMk (standardCoefficientImageRepresentation f) x y) : Cᵐᵒᵖ) =
      MulOpposite.op (f (MulOpposite.unop x) * MulOpposite.unop y) := by
  change (standardInteriorModuleTensorEquivEssential
    (standardCoefficientImageRepresentation f)
    (interiorModuleTensorMk (standardCoefficientImageRepresentation f) x y) : Cᵐᵒᵖ) = _
  rw [standardInteriorModuleTensorEquivEssential_apply,
    standardInteriorModuleTensorEvaluation_mk]
  rfl

theorem standardCoefficientImageTensorEquiv_leftMul (f : B →⋆ₙₐ[ℂ] C) (b : B)
    (u : InteriorModuleTensor (E := Bᵐᵒᵖ) (standardCoefficientImageRepresentation f)) :
    standardCoefficientImageTensorEquiv f
      (interiorModuleTensorOperator (standardCoefficientImageRepresentation f)
        (standardLeftMul b) u) =
      coefficientImageLeftMul f b (standardCoefficientImageTensorEquiv f u) := by
  let W := standardCoefficientImageTensorEquiv f
  let L := W.toAdjointable.toCLM.comp
      (interiorModuleTensorOperator (standardCoefficientImageRepresentation f)
        (standardLeftMul b)).toCLM -
    (coefficientImageLeftMul f b).toCLM.comp W.toAdjointable.toCLM
  have hp : Submodule.span ℂ (Set.range fun p : Bᵐᵒᵖ × Cᵐᵒᵖ =>
      interiorModuleTensorMk (standardCoefficientImageRepresentation f) p.1 p.2) ≤
      L.ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨x, y⟩, rfl⟩
    change W (interiorModuleTensorOperator (standardCoefficientImageRepresentation f)
      (standardLeftMul b)
      (interiorModuleTensorMk (standardCoefficientImageRepresentation f) x y)) -
      coefficientImageLeftMul f b
        (W (interiorModuleTensorMk (standardCoefficientImageRepresentation f) x y)) = 0
    apply sub_eq_zero.mpr
    rw [interiorModuleTensorOperator_mk]
    apply Subtype.ext
    rw [standardCoefficientImageTensorEquiv_mk, coefficientImageLeftMul_coe,
      standardCoefficientImageTensorEquiv_mk]
    change MulOpposite.op (f (b * MulOpposite.unop x) * MulOpposite.unop y) =
      MulOpposite.op (f b * (f (MulOpposite.unop x) * MulOpposite.unop y))
    rw [map_mul, mul_assoc]
  have hu : u ∈ L.ker :=
    (interiorModuleTensor_span_dense (standardCoefficientImageRepresentation f)).induction
      (fun _ hv => hp hv) L.isClosed_ker u
  exact sub_eq_zero.mp hu

theorem standardCoefficientImageTensorEquiv_transport_leftMul
    (f : B →⋆ₙₐ[ℂ] C) (b : B) :
    (standardCoefficientImageTensorEquiv f).transport
      (interiorModuleTensorOperator (standardCoefficientImageRepresentation f)
        (standardLeftMul b)) = coefficientImageLeftMul f b := by
  apply AdjointableMap.ext
  intro z
  obtain ⟨u, rfl⟩ := (standardCoefficientImageTensorEquiv f).surjective z
  rw [HilbertModuleEquiv.transport_apply, HilbertModuleEquiv.symm_apply_apply]
  exact standardCoefficientImageTensorEquiv_leftMul f b u

end BC4lean.KKTheory
