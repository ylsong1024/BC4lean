import BC4lean.CStarGeneratedApproximateUnit

/-! # Hypotheses preserved when adjoining the compact ideal

The actual closed algebra generated by the first algebra and a closed
two-sided star ideal retains the product, normalizer, and action hypotheses
of the countable discrete technical theorem. All ideal claims are actual
membership statements in the specified norm-closed ideal.
-/

noncomputable section
namespace BC4lean.KKTheory

open scoped Topology
variable {A : Type*} [NonUnitalCStarAlgebra A]

/-- A specified norm-closed star subalgebra is a genuine ambient two-sided
ideal when multiplication by every ambient element preserves membership. -/
structure IsClosedTwoSidedStarIdeal (K : NonUnitalStarSubalgebra ℂ A) : Prop where
  closed : IsClosed (K : Set A)
  left_mul : ∀ (a : A) {k : A}, k ∈ K → a * k ∈ K
  right_mul : ∀ (a : A) {k : A}, k ∈ K → k * a ∈ K

namespace IsClosedTwoSidedStarIdeal
variable {K : NonUnitalStarSubalgebra ℂ A} (hK : IsClosedTwoSidedStarIdeal K)

/-- The actual two-sided ideal-multiplier condition for a star-stable set
of tests is closed under all star algebra operations. -/
def testMultiplierAlgebra (tests : Set A)
    (htests : ∀ b ∈ tests, star b ∈ tests) : NonUnitalStarSubalgebra ℂ A where
  carrier := {a | ∀ b ∈ tests, a * b ∈ K ∧ b * a ∈ K}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb c hc
    simpa [add_mul, mul_add] using
      And.intro (K.add_mem (ha c hc).1 (hb c hc).1)
        (K.add_mem (ha c hc).2 (hb c hc).2)
  mul_mem' := by
    intro a b ha hb c hc
    exact ⟨by simpa [mul_assoc] using hK.left_mul a (hb c hc).1,
      by simpa [mul_assoc] using hK.right_mul b (ha c hc).2⟩
  smul_mem' := by
    intro z a ha b hb
    exact ⟨by simpa [smul_mul_assoc] using K.smul_mem z (ha b hb).1,
      by simpa [mul_smul_comm] using K.smul_mem z (ha b hb).2⟩
  star_mem' := by
    intro a ha b hb
    have h := ha (star b) (htests b hb)
    exact ⟨by simpa using K.star_mem' h.2, by simpa using K.star_mem' h.1⟩

theorem testMultiplierAlgebra_isClosed (tests : Set A)
    (htests : ∀ b ∈ tests, star b ∈ tests) :
    IsClosed (hK.testMultiplierAlgebra tests htests : Set A) := by
  change IsClosed {a : A | ∀ b ∈ tests, a * b ∈ K ∧ b * a ∈ K}
  simp only [Set.ofPred_forall]
  apply isClosed_iInter
  intro b
  apply isClosed_iInter
  intro hb
  exact (hK.closed.preimage (continuous_id.mul continuous_const)).inter
    (hK.closed.preimage (continuous_const.mul continuous_id))

include hK in
/-- Products into the actual ideal survive passage to the generated
closed augmented algebra, including the discrete strict-family tests. -/
theorem generated_test_products
    (S : NonUnitalStarSubalgebra ℂ A) (tests : Set A)
    (htests : ∀ b ∈ tests, star b ∈ tests)
    (hS : ∀ a ∈ S, ∀ b ∈ tests, a * b ∈ K ∧ b * a ∈ K)
    {a : A} (ha : a ∈ generatedClosedStarAlgebra S K) :
    ∀ b ∈ tests, a * b ∈ K ∧ b * a ∈ K := by
  apply generatedClosedStarAlgebra_le S K (hK.testMultiplierAlgebra tests htests)
    (hK.testMultiplierAlgebra_isClosed tests htests) hS _ ha
  intro k hk b _
  exact ⟨hK.right_mul b hk, hK.left_mul b hk⟩

/-- The source theorem's one-sided E₁E₂ ideal hypothesis also gives the
opposite-sided product by the actual star operation. -/
theorem opposite_products_of_starSubalgebras
    (S T : NonUnitalStarSubalgebra ℂ A)
    (hST : ∀ a ∈ S, ∀ b ∈ T, a * b ∈ K) :
    ∀ a ∈ S, ∀ b ∈ T, a * b ∈ K ∧ b * a ∈ K := by
  intro a ha b hb
  exact ⟨hST a ha b hb, by
    simpa using K.star_mem' (hST (star a) (S.star_mem' ha) (star b) (T.star_mem' hb))⟩

include hK in
theorem generated_algebra_products
    (S T : NonUnitalStarSubalgebra ℂ A)
    (hST : ∀ a ∈ S, ∀ b ∈ T, a * b ∈ K) :
    ∀ a ∈ generatedClosedStarAlgebra S K, ∀ b ∈ T,
      a * b ∈ K ∧ b * a ∈ K :=
  fun _ ha => hK.generated_test_products S T (fun _ hb => T.star_mem' hb)
    (opposite_products_of_starSubalgebras S T hST) ha

end IsClosedTwoSidedStarIdeal

/-- Star normalization follows from normalization itself for a star
subalgebra; both conditions are explicit in the represented support proof. -/
theorem star_normalizes_starSubalgebra (S : NonUnitalStarSubalgebra ℂ A) (d : A)
    (hd : ∀ a ∈ S, d * a - a * d ∈ S) :
    ∀ a ∈ S, star d * a - a * star d ∈ S := by
  intro a ha
  have h := S.neg_mem (S.star_mem' (hd (star a) (S.star_mem' ha)))
  change star d * a - a * star d ∈ S.toSubmodule
  simpa only [star_sub, star_mul, star_star, neg_sub] using h

/-- A commutator normalizer of the first algebra also normalizes its
actual augmentation by an ambient two-sided star ideal. -/
theorem normalizes_generatedClosedStarAlgebra
    (S K : NonUnitalStarSubalgebra ℂ A) (hK : IsClosedTwoSidedStarIdeal K) (d : A)
    (hd : ∀ a ∈ S, d * a - a * d ∈ S) :
    ∀ a ∈ generatedClosedStarAlgebra S K,
      d * a - a * d ∈ generatedClosedStarAlgebra S K := by
  let U := generatedClosedStarAlgebra S K
  let W := NonUnitalStarAlgebra.adjoin ℂ ((S : Set A) ∪ (K : Set A))
  have hS : S ≤ U := le_generatedClosedStarAlgebra_left S K
  have hJ : K ≤ U := le_generatedClosedStarAlgebra_right S K
  have hW : W ≤ U := NonUnitalStarSubalgebra.le_topologicalClosure W
  have hbase : ∀ a ∈ W, d * a - a * d ∈ U ∧ star d * a - a * star d ∈ U := by
    intro a ha
    induction ha using NonUnitalStarAlgebra.adjoin_induction with
    | mem a ha =>
      rcases ha with ha | ha
      · exact ⟨hS (hd a ha), hS (star_normalizes_starSubalgebra S d hd a ha)⟩
      · exact ⟨hJ (K.sub_mem (hK.left_mul d ha) (hK.right_mul d ha)),
          hJ (K.sub_mem (hK.left_mul (star d) ha) (hK.right_mul (star d) ha))⟩
    | zero => simp
    | add a b ha hb hda hdb =>
      constructor
      · have heq : d * (a + b) - (a + b) * d =
            (d * a - a * d) + (d * b - b * d) := by noncomm_ring
        rw [heq]
        exact U.add_mem hda.1 hdb.1
      · have heq : star d * (a + b) - (a + b) * star d =
            (star d * a - a * star d) + (star d * b - b * star d) := by noncomm_ring
        rw [heq]
        exact U.add_mem hda.2 hdb.2
    | mul a b ha hb hda hdb =>
      constructor
      · have heq : d * (a * b) - (a * b) * d =
            (d * a - a * d) * b + a * (d * b - b * d) := by noncomm_ring
        rw [heq]
        exact U.add_mem (U.mul_mem hda.1 (hW hb)) (U.mul_mem (hW ha) hdb.1)
      · have heq : star d * (a * b) - (a * b) * star d =
            (star d * a - a * star d) * b + a * (star d * b - b * star d) := by noncomm_ring
        rw [heq]
        exact U.add_mem (U.mul_mem hda.2 (hW hb)) (U.mul_mem (hW ha) hdb.2)
    | smul c a ha hda =>
      constructor
      · simpa [mul_smul_comm, smul_mul_assoc, smul_sub] using U.smul_mem c hda.1
      · simpa [mul_smul_comm, smul_mul_assoc, smul_sub] using U.smul_mem c hda.2
    | star a ha hda =>
      constructor
      · change d * star a - star a * d ∈ U.toSubmodule
        simpa only [star_sub, star_mul, star_star, neg_sub] using U.neg_mem (U.star_mem' hda.2)
      · change star d * star a - star a * star d ∈ U.toSubmodule
        simpa only [star_sub, star_mul, star_star, neg_sub] using U.neg_mem (U.star_mem' hda.1)
  have hclosed : IsClosed {a : A | d * a - a * d ∈ U} :=
    (generatedClosedStarAlgebra_isClosed S K).preimage
      ((continuous_const.mul continuous_id).sub (continuous_id.mul continuous_const))
  intro a ha
  exact closure_minimal (fun a ha => (hbase a ha).1) hclosed ha

/-- An ambient star automorphism preserving the two source algebras
preserves their actual generated norm closure. -/
theorem maps_generatedClosedStarAlgebra
    (S T : NonUnitalStarSubalgebra ℂ A) (α : A ≃⋆ₐ[ℂ] A)
    (hS : ∀ a ∈ S, α a ∈ S) (hT : ∀ a ∈ T, α a ∈ T) :
    ∀ a ∈ generatedClosedStarAlgebra S T, α a ∈ generatedClosedStarAlgebra S T := by
  let U := generatedClosedStarAlgebra S T
  let R := U.comap α.toNonUnitalStarAlgHom
  have hclosed : IsClosed (R : Set A) :=
    (generatedClosedStarAlgebra_isClosed S T).preimage (NonUnitalStarAlgHom.isometry α α.injective).continuous
  exact generatedClosedStarAlgebra_le S T R hclosed
    (fun a ha => le_generatedClosedStarAlgebra_left S T (hS a ha))
    (fun a ha => le_generatedClosedStarAlgebra_right S T (hT a ha))

end BC4lean.KKTheory
