import BC4lean.ClosedRightHilbertModule
import Mathlib.Topology.Algebra.Module.Basic

/-! # The actual right module generated by a coefficient homomorphism

For an arbitrary nonunital star homomorphism f, the carrier is the norm
closure of the complex span of f(b)c. It is a closed right Hilbert module
inside the standard target module. It is not declared a star algebra, a
two-sided ideal or an adjointably complemented submodule. Left f(b) acts
adjointably and compactly, by actual rank-one approximate-unit factorizations.
-/

noncomputable section
namespace BC4lean.KKTheory
open Filter
open scoped InnerProductSpace Topology CStarAlgebra

variable {B C : Type*} [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]

def coefficientImageProducts (f : B →⋆ₙₐ[ℂ] C) : Set Cᵐᵒᵖ :=
  Set.range fun p : B × C => MulOpposite.op (f p.1 * p.2)

def coefficientImageSpan (f : B →⋆ₙₐ[ℂ] C) : Submodule ℂ Cᵐᵒᵖ :=
  Submodule.span ℂ (coefficientImageProducts f)

def coefficientImageClosedSubmodule (f : B →⋆ₙₐ[ℂ] C) : Submodule ℂ Cᵐᵒᵖ :=
  (coefficientImageSpan f).topologicalClosure

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImageClosedSubmodule_isClosed (f : B →⋆ₙₐ[ℂ] C) :
    IsClosed (coefficientImageClosedSubmodule f : Set Cᵐᵒᵖ) :=
  Submodule.isClosed_topologicalClosure _

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImage_product_mem (f : B →⋆ₙₐ[ℂ] C) (b : B) (c : C) :
    MulOpposite.op (f b * c) ∈ coefficientImageClosedSubmodule f :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span ⟨(b, c), rfl⟩)

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImageSpan_op_smul_mem (f : B →⋆ₙₐ[ℂ] C)
    (b x : Cᵐᵒᵖ) (hx : x ∈ coefficientImageSpan f) :
    b • x ∈ coefficientImageSpan f := by
  let L := (ContinuousLinearMap.mul ℂ Cᵐᵒᵖ) b
  have h : coefficientImageSpan f ≤ (coefficientImageSpan f).comap L.toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨a, c⟩, rfl⟩
    change MulOpposite.op ((f a * c) * MulOpposite.unop b) ∈ coefficientImageSpan f
    rw [mul_assoc]
    exact Submodule.subset_span ⟨(a, c * MulOpposite.unop b), rfl⟩
  exact h hx

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImageClosedSubmodule_op_smul_mem (f : B →⋆ₙₐ[ℂ] C)
    (b x : Cᵐᵒᵖ) (hx : x ∈ coefficientImageClosedSubmodule f) :
    b • x ∈ coefficientImageClosedSubmodule f := by
  let L := (ContinuousLinearMap.mul ℂ Cᵐᵒᵖ) b
  let T := (coefficientImageClosedSubmodule f).comap L.toLinearMap
  have hspan : coefficientImageSpan f ≤ T := by
    intro y hy
    exact Submodule.le_topologicalClosure _ (coefficientImageSpan_op_smul_mem f b y hy)
  have hT : IsClosed (T : Set Cᵐᵒᵖ) :=
    (coefficientImageClosedSubmodule_isClosed f).preimage L.continuous
  exact (Submodule.topologicalClosure_minimal _ hspan hT) hx

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImageSpan_left_mem (f : B →⋆ₙₐ[ℂ] C)
    (a : B) (x : Cᵐᵒᵖ) (hx : x ∈ coefficientImageSpan f) :
    standardLeftMulCLM (f a) x ∈ coefficientImageSpan f := by
  have h : coefficientImageSpan f ≤ (coefficientImageSpan f).comap
      (standardLeftMulCLM (f a)).toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨b, c⟩, rfl⟩
    change MulOpposite.op (f a * (f b * c)) ∈ coefficientImageSpan f
    rw [← mul_assoc, ← map_mul]
    exact Submodule.subset_span ⟨(a * b, c), rfl⟩
  exact h hx

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImageClosedSubmodule_left_mem (f : B →⋆ₙₐ[ℂ] C)
    (a : B) (x : Cᵐᵒᵖ) (hx : x ∈ coefficientImageClosedSubmodule f) :
    standardLeftMulCLM (f a) x ∈ coefficientImageClosedSubmodule f := by
  let L := standardLeftMulCLM (f a)
  let T := (coefficientImageClosedSubmodule f).comap L.toLinearMap
  have hspan : coefficientImageSpan f ≤ T := by
    intro y hy
    exact Submodule.le_topologicalClosure _ (coefficientImageSpan_left_mem f a y hy)
  have hT : IsClosed (T : Set Cᵐᵒᵖ) :=
    (coefficientImageClosedSubmodule_isClosed f).preimage L.continuous
  exact (Submodule.topologicalClosure_minimal _ hspan hT) hx

omit [PartialOrder C] [StarOrderedRing C] in
/-- The actual image elements lie in the right closure without a target unit. -/
theorem coefficientImage_image_mem (f : B →⋆ₙₐ[ℂ] C) (b : B) :
    MulOpposite.op (f b) ∈ coefficientImageClosedSubmodule f := by
  have hlim : Tendsto (fun u : B => MulOpposite.op (f (b * u)))
      (CStarAlgebra.approximateUnit B) (𝓝 (MulOpposite.op (f b))) :=
    (MulOpposite.continuous_op.comp (map_continuous f)).tendsto b |>.comp
      ((CStarAlgebra.increasingApproximateUnit B).tendsto_mul_left b)
  apply (coefficientImageClosedSubmodule_isClosed f).mem_of_tendsto hlim
  exact Eventually.of_forall fun u => by
    rw [map_mul]
    exact coefficientImage_product_mem f b (f u)

def coefficientImageRightSubspace (f : B →⋆ₙₐ[ℂ] C) : ClosedRightModuleSubspace C where
  submodule := coefficientImageClosedSubmodule f
  isClosed := coefficientImageClosedSubmodule_isClosed f
  op_smul_mem := coefficientImageClosedSubmodule_op_smul_mem f

abbrev CoefficientImageRightModule (f : B →⋆ₙₐ[ℂ] C) :=
  ClosedRightHilbertModule (coefficientImageRightSubspace f)

def coefficientImageVector (f : B →⋆ₙₐ[ℂ] C) (b : B) : CoefficientImageRightModule f :=
  ⟨MulOpposite.op (f b), coefficientImage_image_mem f b⟩

omit [PartialOrder C] [StarOrderedRing C] in
@[simp] theorem coefficientImageVector_coe (f : B →⋆ₙₐ[ℂ] C) (b : B) :
    (coefficientImageVector f b : Cᵐᵒᵖ) = MulOpposite.op (f b) := rfl

def coefficientImageLeftMul (f : B →⋆ₙₐ[ℂ] C) :
    B →⋆ₙₐ[ℂ] AdjointableMap C (CoefficientImageRightModule f) (CoefficientImageRightModule f) :=
  ClosedRightHilbertModule.representation (coefficientImageRightSubspace f) f
    (coefficientImageClosedSubmodule_left_mem f)

omit [PartialOrder B] [StarOrderedRing B] in
@[simp] theorem coefficientImageLeftMul_coe (f : B →⋆ₙₐ[ℂ] C)
    (b : B) (x : CoefficientImageRightModule f) :
    (coefficientImageLeftMul f b x : Cᵐᵒᵖ) =
      MulOpposite.op (f b * MulOpposite.unop (x : Cᵐᵒᵖ)) := rfl

omit [PartialOrder B] [StarOrderedRing B] in
theorem coefficientImageRightModule_countablyGenerated [TopologicalSpace.SeparableSpace C]
    (f : B →⋆ₙₐ[ℂ] C) : IsCountablyGeneratedModule C (CoefficientImageRightModule f) :=
  ClosedRightHilbertModule.countablyGenerated _

/-- The vectors are in the true right submodule and give the actual rank-one identity. -/
theorem coefficientImage_rankOne (f : B →⋆ₙₐ[ℂ] C) (a b : B) :
    moduleRankOne (B := C) (coefficientImageVector f a) (coefficientImageVector f (star b)) =
      coefficientImageLeftMul f (a * b) := by
  apply AdjointableMap.ext
  intro x
  apply Subtype.ext
  change ⟪MulOpposite.op (f (star b)), (x : Cᵐᵒᵖ)⟫_(Cᵐᵒᵖ) • MulOpposite.op (f a) =
    MulOpposite.op (f (a * b) * MulOpposite.unop (x : Cᵐᵒᵖ))
  have h := congrArg (fun T : AdjointableMap C Cᵐᵒᵖ Cᵐᵒᵖ => T (x : Cᵐᵒᵖ))
    (standard_moduleRankOne_eq_leftMul (MulOpposite.op (f a)) (MulOpposite.op (f (star b))))
  change ⟪MulOpposite.op (f (star b)), (x : Cᵐᵒᵖ)⟫_(Cᵐᵒᵖ) • MulOpposite.op (f a) =
    MulOpposite.op ((f a * star (f (star b))) * MulOpposite.unop (x : Cᵐᵒᵖ)) at h
  simpa only [map_star, star_star, map_mul] using h

/-- Left image multiplication is compact; no compactness of the inclusion is used. -/
theorem coefficientImageLeftMul_isModuleCompact (f : B →⋆ₙₐ[ℂ] C) (b : B) :
    IsModuleCompact (coefficientImageLeftMul f b) := by
  have hlim : Tendsto (fun u : B => coefficientImageLeftMul f (b * u))
      (CStarAlgebra.approximateUnit B) (𝓝 (coefficientImageLeftMul f b)) :=
    (map_continuous (coefficientImageLeftMul f)).tendsto b |>.comp
      ((CStarAlgebra.increasingApproximateUnit B).tendsto_mul_left b)
  apply moduleCompact_isClosed.mem_of_tendsto hlim
  exact Eventually.of_forall fun u => by
    rw [← coefficientImage_rankOne f b u]
    exact moduleRankOne_mem_moduleCompact _ _

end BC4lean.KKTheory
