import BC4lean.CoefficientImageRightModule
import BC4lean.GradedMatrixMoritaFibreEvaluation
import Mathlib.Topology.ContinuousMap.SecondCountableSpace

/-! # A genuine interval bridge for a degenerate coefficient map

The module consists of continuous target-algebra sections whose value at one
belongs to the closed right module generated by f(B)C. Its completed fibre at
zero is the full standard target module, and its completed fibre at one is
the actual image right module. Evaluation preserves the whole coefficient
form, descends through its radical and extends to the completion. Explicit
ramp and constant sections prove onto-ness. No complement of the right module
and no star closure of that right module are assumed.
-/

noncomputable section
namespace BC4lean.KKTheory
open Filter
open scoped InnerProductSpace Topology

variable {B C : Type*} [NonUnitalCStarAlgebra B] [NonUnitalCStarAlgebra C]
  [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C]

def standardIntervalCoefficientEvaluation (t : unitInterval) :
    C(unitInterval, C)ᵐᵒᵖ →L[ℂ] Cᵐᵒᵖ :=
  ({ toFun := fun s => MulOpposite.op (MulOpposite.unop s t)
     map_add' _ _ := rfl
     map_smul' _ _ := rfl } : C(unitInterval, C)ᵐᵒᵖ →ₗ[ℂ] Cᵐᵒᵖ).mkContinuous
    1 (fun s => by
      change ‖MulOpposite.op (MulOpposite.unop s t)‖ ≤ 1 * ‖s‖
      simpa only [MulOpposite.norm_op, MulOpposite.norm_unop, one_mul] using
        (MulOpposite.unop s).norm_coe_le_norm t)

omit [PartialOrder C] [StarOrderedRing C] in
@[simp] theorem standardIntervalCoefficientEvaluation_apply (t : unitInterval)
    (s : C(unitInterval, C)ᵐᵒᵖ) :
    standardIntervalCoefficientEvaluation t s = MulOpposite.op (MulOpposite.unop s t) := rfl

def coefficientImageIntervalSubmodule (f : B →⋆ₙₐ[ℂ] C) :
    Submodule ℂ C(unitInterval, C)ᵐᵒᵖ :=
  (coefficientImageClosedSubmodule f).comap
    (standardIntervalCoefficientEvaluation (C := C) 1).toLinearMap

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImageIntervalSubmodule_isClosed (f : B →⋆ₙₐ[ℂ] C) :
    IsClosed (coefficientImageIntervalSubmodule f : Set C(unitInterval, C)ᵐᵒᵖ) :=
  (coefficientImageClosedSubmodule_isClosed f).preimage
    (standardIntervalCoefficientEvaluation (C := C) 1).continuous

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
theorem coefficientImageIntervalSubmodule_op_smul_mem (f : B →⋆ₙₐ[ℂ] C)
    (a s : C(unitInterval, C)ᵐᵒᵖ) (hs : s ∈ coefficientImageIntervalSubmodule f) :
    a • s ∈ coefficientImageIntervalSubmodule f := by
  exact coefficientImageClosedSubmodule_op_smul_mem f
    (MulOpposite.op (MulOpposite.unop a 1))
    (MulOpposite.op (MulOpposite.unop s 1)) hs

def coefficientImageIntervalRightSubspace (f : B →⋆ₙₐ[ℂ] C) :
    ClosedRightModuleSubspace C(unitInterval, C) where
  submodule := coefficientImageIntervalSubmodule f
  isClosed := coefficientImageIntervalSubmodule_isClosed f
  op_smul_mem := coefficientImageIntervalSubmodule_op_smul_mem f

abbrev CoefficientImageIntervalModule (f : B →⋆ₙₐ[ℂ] C) :=
  ClosedRightHilbertModule (coefficientImageIntervalRightSubspace f)

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
@[simp] theorem coefficientImageIntervalModule_mem_one (f : B →⋆ₙₐ[ℂ] C)
    (s : CoefficientImageIntervalModule f) :
    MulOpposite.op (MulOpposite.unop (s : C(unitInterval, C)ᵐᵒᵖ) 1) ∈
      coefficientImageClosedSubmodule f := s.property

omit [PartialOrder B] [StarOrderedRing B] in
theorem coefficientImageIntervalModule_countablyGenerated [TopologicalSpace.SeparableSpace C]
    (f : B →⋆ₙₐ[ℂ] C) :
    IsCountablyGeneratedModule C(unitInterval, C) (CoefficientImageIntervalModule f) := by
  let : TopologicalSpace.SeparableSpace C(unitInterval, C) := inferInstance
  exact ClosedRightHilbertModule.countablyGenerated _

def coefficientImageIntervalZeroEvaluation (f : B →⋆ₙₐ[ℂ] C) :
    CoefficientImageIntervalModule f →L[ℂ] Cᵐᵒᵖ :=
  (standardIntervalCoefficientEvaluation 0).comp (coefficientImageIntervalSubmodule f).subtypeL

def coefficientImageIntervalOneEvaluation (f : B →⋆ₙₐ[ℂ] C) :
    CoefficientImageIntervalModule f →L[ℂ] CoefficientImageRightModule f :=
  ((standardIntervalCoefficientEvaluation 1).comp (coefficientImageIntervalSubmodule f).subtypeL).codRestrict
    (coefficientImageClosedSubmodule f) (fun s => s.property)

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
@[simp] theorem coefficientImageIntervalZeroEvaluation_apply (f : B →⋆ₙₐ[ℂ] C)
    (s : CoefficientImageIntervalModule f) :
    coefficientImageIntervalZeroEvaluation f s =
      MulOpposite.op (MulOpposite.unop (s : C(unitInterval, C)ᵐᵒᵖ) 0) := rfl

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
@[simp] theorem coefficientImageIntervalOneEvaluation_coe (f : B →⋆ₙₐ[ℂ] C)
    (s : CoefficientImageIntervalModule f) :
    (coefficientImageIntervalOneEvaluation f s : Cᵐᵒᵖ) =
      MulOpposite.op (MulOpposite.unop (s : C(unitInterval, C)ᵐᵒᵖ) 1) := rfl

def coefficientImageIntervalRamp (f : B →⋆ₙₐ[ℂ] C) (c : Cᵐᵒᵖ) :
    CoefficientImageIntervalModule f :=
  ⟨MulOpposite.op ⟨fun t => (1 - (t : ℝ)) • MulOpposite.unop c, by fun_prop⟩, by
    change MulOpposite.op ((1 - (1 : ℝ)) • MulOpposite.unop c) ∈ coefficientImageClosedSubmodule f
    simpa only [sub_self, zero_smul, MulOpposite.op_zero] using
      (coefficientImageClosedSubmodule f).zero_mem⟩

def coefficientImageIntervalConstant (f : B →⋆ₙₐ[ℂ] C)
    (c : CoefficientImageRightModule f) : CoefficientImageIntervalModule f :=
  ⟨MulOpposite.op (ContinuousMap.const unitInterval (MulOpposite.unop (c : Cᵐᵒᵖ))),
    c.property⟩

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
@[simp] theorem coefficientImageIntervalZeroEvaluation_ramp (f : B →⋆ₙₐ[ℂ] C)
    (c : Cᵐᵒᵖ) :
    coefficientImageIntervalZeroEvaluation f (coefficientImageIntervalRamp f c) = c := by
  change MulOpposite.op ((1 - (0 : ℝ)) • MulOpposite.unop c) = c
  simp

omit [PartialOrder B] [StarOrderedRing B] [PartialOrder C] [StarOrderedRing C] in
@[simp] theorem coefficientImageIntervalOneEvaluation_constant (f : B →⋆ₙₐ[ℂ] C)
    (c : CoefficientImageRightModule f) :
    coefficientImageIntervalOneEvaluation f (coefficientImageIntervalConstant f c) = c := rfl

omit [PartialOrder B] [StarOrderedRing B] in
theorem coefficientImageIntervalZeroEvaluation_inner (f : B →⋆ₙₐ[ℂ] C)
    (s r : CoefficientImageIntervalModule f) :
    ⟪coefficientImageIntervalZeroEvaluation f s,
      coefficientImageIntervalZeroEvaluation f r⟫_(Cᵐᵒᵖ) =
    MulOpposite.op (MulOpposite.unop ⟪s, r⟫_(C(unitInterval, C)ᵐᵒᵖ) 0) := rfl

omit [PartialOrder B] [StarOrderedRing B] in
theorem coefficientImageIntervalOneEvaluation_inner (f : B →⋆ₙₐ[ℂ] C)
    (s r : CoefficientImageIntervalModule f) :
    ⟪coefficientImageIntervalOneEvaluation f s,
      coefficientImageIntervalOneEvaluation f r⟫_(Cᵐᵒᵖ) =
    MulOpposite.op (MulOpposite.unop ⟪s, r⟫_(C(unitInterval, C)ᵐᵒᵖ) 1) := rfl

def coefficientImageIntervalZeroFibreIsometry (f : B →⋆ₙₐ[ℂ] C) :
    HilbertModuleFibre C (CoefficientImageIntervalModule f) (0 : unitInterval) →ₗᵢ[ℂ] Cᵐᵒᵖ :=
  GradedMatrixMoritaFibreEvaluation.completedIsometry (X := unitInterval) (0 : unitInterval)
    (coefficientImageIntervalZeroEvaluation f) (coefficientImageIntervalZeroEvaluation_inner f)

def coefficientImageIntervalOneFibreIsometry (f : B →⋆ₙₐ[ℂ] C) :
    HilbertModuleFibre C (CoefficientImageIntervalModule f) (1 : unitInterval) →ₗᵢ[ℂ]
      CoefficientImageRightModule f :=
  GradedMatrixMoritaFibreEvaluation.completedIsometry (X := unitInterval) (1 : unitInterval)
    (coefficientImageIntervalOneEvaluation f) (coefficientImageIntervalOneEvaluation_inner f)

omit [PartialOrder B] [StarOrderedRing B] in
@[simp] theorem coefficientImageIntervalZeroFibreIsometry_mk (f : B →⋆ₙₐ[ℂ] C)
    (s : CoefficientImageIntervalModule f) :
    coefficientImageIntervalZeroFibreIsometry f (hilbertModuleFibreMk (B := C) (0 : unitInterval) s) =
      coefficientImageIntervalZeroEvaluation f s :=
  GradedMatrixMoritaFibreEvaluation.completedIsometry_mk (X := unitInterval) _ _ _ s

omit [PartialOrder B] [StarOrderedRing B] in
@[simp] theorem coefficientImageIntervalOneFibreIsometry_mk (f : B →⋆ₙₐ[ℂ] C)
    (s : CoefficientImageIntervalModule f) :
    coefficientImageIntervalOneFibreIsometry f (hilbertModuleFibreMk (B := C) (1 : unitInterval) s) =
      coefficientImageIntervalOneEvaluation f s :=
  GradedMatrixMoritaFibreEvaluation.completedIsometry_mk (X := unitInterval) _ _ _ s

omit [PartialOrder B] [StarOrderedRing B] in
theorem coefficientImageIntervalZeroFibreIsometry_surjective (f : B →⋆ₙₐ[ℂ] C) :
    Function.Surjective (coefficientImageIntervalZeroFibreIsometry f) := by
  intro c
  refine ⟨hilbertModuleFibreMk (B := C) (0 : unitInterval) (coefficientImageIntervalRamp f c), ?_⟩
  rw [coefficientImageIntervalZeroFibreIsometry_mk, coefficientImageIntervalZeroEvaluation_ramp]

omit [PartialOrder B] [StarOrderedRing B] in
theorem coefficientImageIntervalOneFibreIsometry_surjective (f : B →⋆ₙₐ[ℂ] C) :
    Function.Surjective (coefficientImageIntervalOneFibreIsometry f) := by
  intro c
  refine ⟨hilbertModuleFibreMk (B := C) (1 : unitInterval) (coefficientImageIntervalConstant f c), ?_⟩
  rw [coefficientImageIntervalOneFibreIsometry_mk, coefficientImageIntervalOneEvaluation_constant]

def coefficientImageIntervalZeroFibreEquiv (f : B →⋆ₙₐ[ℂ] C) :
    HilbertModuleEquiv C (HilbertModuleFibre C (CoefficientImageIntervalModule f) (0 : unitInterval)) Cᵐᵒᵖ where
  linearIsometryEquiv := LinearIsometryEquiv.ofSurjective
    (coefficientImageIntervalZeroFibreIsometry f) (coefficientImageIntervalZeroFibreIsometry_surjective f)
  inner_map := GradedMatrixMoritaFibreEvaluation.completedIsometry_inner (X := unitInterval) _ _ _

def coefficientImageIntervalOneFibreEquiv (f : B →⋆ₙₐ[ℂ] C) :
    HilbertModuleEquiv C (HilbertModuleFibre C (CoefficientImageIntervalModule f) (1 : unitInterval))
      (CoefficientImageRightModule f) where
  linearIsometryEquiv := LinearIsometryEquiv.ofSurjective
    (coefficientImageIntervalOneFibreIsometry f) (coefficientImageIntervalOneFibreIsometry_surjective f)
  inner_map := GradedMatrixMoritaFibreEvaluation.completedIsometry_inner (X := unitInterval) _ _ _

omit [PartialOrder B] [StarOrderedRing B] in
@[simp] theorem coefficientImageIntervalZeroFibreEquiv_mk (f : B →⋆ₙₐ[ℂ] C)
    (s : CoefficientImageIntervalModule f) :
    coefficientImageIntervalZeroFibreEquiv f (hilbertModuleFibreMk (B := C) (0 : unitInterval) s) =
      coefficientImageIntervalZeroEvaluation f s := coefficientImageIntervalZeroFibreIsometry_mk f s

omit [PartialOrder B] [StarOrderedRing B] in
@[simp] theorem coefficientImageIntervalOneFibreEquiv_mk (f : B →⋆ₙₐ[ℂ] C)
    (s : CoefficientImageIntervalModule f) :
    coefficientImageIntervalOneFibreEquiv f (hilbertModuleFibreMk (B := C) (1 : unitInterval) s) =
      coefficientImageIntervalOneEvaluation f s := coefficientImageIntervalOneFibreIsometry_mk f s

end BC4lean.KKTheory
