import BC4lean.IntervalKasparovGluing
import BC4lean.IntervalModuleCompactFibre
import Mathlib.Topology.Algebra.NonUnitalStarAlgebra

/-! # The actual compact algebra of compatible endpoint pairs

The closed nonunital star algebra generated by rank-one pairs of matched
vectors equals the full algebra of endpoint-compatible compact pairs. The
proof first lifts the common middle compact through that generated algebra;
the two residual endpoint-null compacts lie in it by the proved exact fibre
kernel description. No compact restriction to a general reducing submodule
is asserted.
-/

noncomputable section
namespace BC4lean.KKTheory

open scoped InnerProductSpace

variable {B M N : Type*} [NonUnitalCStarAlgebra B] [PartialOrder B] [StarOrderedRing B]
  [NormedAddCommGroup M] [NormedSpace ℂ M]
  [SMul C(unitInterval, B)ᵐᵒᵖ M] [CStarModule C(unitInterval, B)ᵐᵒᵖ M]
  [NormedAddCommGroup N] [NormedSpace ℂ N]
  [SMul C(unitInterval, B)ᵐᵒᵖ N] [CStarModule C(unitInterval, B)ᵐᵒᵖ N]
  [CompleteSpace M] [CompleteSpace N]

variable (U : HilbertModuleEquiv B (HilbertModuleFibre B M (1 : unitInterval))
  (HilbertModuleFibre B N (0 : unitInterval)))

/-- A genuine source rank-one pair formed from two matched vectors. -/
def intervalMatchedRankPair (x y : IntervalMatchedModule U) :
    AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N :=
  (moduleRankOne (B := C(unitInterval, B)) x.val.1 y.val.1,
    moduleRankOne (B := C(unitInterval, B)) x.val.2 y.val.2)

/-- First endpoint evaluation, transported to the common middle module. -/
def intervalMatchedLeftBoundaryHom :
    (AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N)
      →⋆ₙₐ[ℂ] AdjointableMap B
        (HilbertModuleFibre B N (0 : unitInterval)) (HilbertModuleFibre B N (0 : unitInterval)) :=
  U.transportStarAlgEquiv.toNonUnitalStarAlgHom.comp
    ((hilbertModuleFibreOperatorHom (B := B) (M := M) (1 : unitInterval)).toNonUnitalStarAlgHom.comp
      (NonUnitalStarAlgHom.fst ℂ _ _))

/-- Second endpoint evaluation into the actual common middle module. -/
def intervalMatchedRightBoundaryHom :
    (AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N)
      →⋆ₙₐ[ℂ] AdjointableMap B
        (HilbertModuleFibre B N (0 : unitInterval)) (HilbertModuleFibre B N (0 : unitInterval)) :=
  (hilbertModuleFibreOperatorHom (B := B) (M := N) (0 : unitInterval)).toNonUnitalStarAlgHom.comp
    (NonUnitalStarAlgHom.snd ℂ _ _)

/-- The full compatible compact-pair algebra, as an actual star-subalgebra
of the product of the two complete adjointable algebras. -/
def intervalMatchedCompactPairAlgebra : NonUnitalStarSubalgebra ℂ
    (AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N) :=
  ((compactModuleOperatorAlgebra (B := C(unitInterval, B)) (E := M)).prod
    (compactModuleOperatorAlgebra (B := C(unitInterval, B)) (E := N))) ⊓
      NonUnitalStarAlgHom.equalizer (intervalMatchedLeftBoundaryHom U)
        (intervalMatchedRightBoundaryHom (B := B) (M := M) (N := N))

@[simp] theorem mem_intervalMatchedCompactPairAlgebra
    (T : AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N) :
    T ∈ intervalMatchedCompactPairAlgebra U ↔
      (IsModuleCompact T.1 ∧ IsModuleCompact T.2) ∧
      U.transport (hilbertModuleFibreOperator (B := B) (1 : unitInterval) T.1) =
        hilbertModuleFibreOperator (B := B) (0 : unitInterval) T.2 := Iff.rfl

instance intervalMatchedCompactPairAlgebra_isClosed :
    IsClosed (intervalMatchedCompactPairAlgebra U : Set
      (AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N)) := by
  exact ((moduleCompact_isClosed (B := C(unitInterval, B)) (E := M) (F := M)).prod
    (moduleCompact_isClosed (B := C(unitInterval, B)) (E := N) (F := N))).inter
      (isClosed_eq (nonUnitalCStarHomCLM (intervalMatchedLeftBoundaryHom U)).continuous
        (nonUnitalCStarHomCLM
          (intervalMatchedRightBoundaryHom (B := B) (M := M) (N := N))).continuous)

instance intervalMatchedCompactPairAlgebra_nonUnitalCStarAlgebra :
    NonUnitalCStarAlgebra (intervalMatchedCompactPairAlgebra U) :=
  NonUnitalStarSubalgebra.nonUnitalCStarAlgebra _

omit [CompleteSpace M] [CompleteSpace N] in
private theorem transport_rankOne
    (x y : HilbertModuleFibre B M (1 : unitInterval)) :
    U.transport (moduleRankOne (B := B) x y) = moduleRankOne (B := B) (U x) (U y) := by
  ext z
  simp only [HilbertModuleEquiv.transport_apply, moduleRankOne_apply,
    U.map_op_smul, U.inner_left]

theorem intervalMatchedRankPair_mem_compactPairAlgebra (x y : IntervalMatchedModule U) :
    intervalMatchedRankPair U x y ∈ intervalMatchedCompactPairAlgebra U := by
  refine ⟨⟨moduleRankOne_mem_moduleCompact _ _, moduleRankOne_mem_moduleCompact _ _⟩, ?_⟩
  change U.transport (hilbertModuleFibreOperator (B := B) (1 : unitInterval)
    (moduleRankOne (B := C(unitInterval, B)) x.val.1 y.val.1)) =
      hilbertModuleFibreOperator (B := B) (0 : unitInterval)
        (moduleRankOne (B := C(unitInterval, B)) x.val.2 y.val.2)
  rw [hilbertModuleFibreOperator_rankOne, hilbertModuleFibreOperator_rankOne,
    transport_rankOne, (mem_intervalMatchedSubmodule U x.val).mp x.property,
    (mem_intervalMatchedSubmodule U y.val).mp y.property]

/-- The norm-closed actual nonunital star algebra generated by the rank-one
pairs of the matching module. -/
def intervalMatchedRankPairAlgebra : NonUnitalStarSubalgebra ℂ
    (AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N) :=
  (NonUnitalStarAlgebra.adjoin ℂ
    (Set.range fun p : IntervalMatchedModule U × IntervalMatchedModule U =>
      intervalMatchedRankPair U p.1 p.2)).topologicalClosure

instance intervalMatchedRankPairAlgebra_isClosed :
    IsClosed (intervalMatchedRankPairAlgebra U : Set
      (AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N)) :=
  NonUnitalStarSubalgebra.isClosed_topologicalClosure _

instance intervalMatchedRankPairAlgebra_nonUnitalCStarAlgebra :
    NonUnitalCStarAlgebra (intervalMatchedRankPairAlgebra U) :=
  NonUnitalStarSubalgebra.nonUnitalCStarAlgebra _

theorem intervalMatchedRankPair_mem_rankPairAlgebra (x y : IntervalMatchedModule U) :
    intervalMatchedRankPair U x y ∈ intervalMatchedRankPairAlgebra U :=
  NonUnitalStarSubalgebra.le_topologicalClosure _
    (NonUnitalStarAlgebra.subset_adjoin ℂ _ ⟨(x, y), rfl⟩)

theorem intervalMatchedRankPairAlgebra_le_compactPairAlgebra :
    intervalMatchedRankPairAlgebra U ≤ intervalMatchedCompactPairAlgebra U := by
  apply NonUnitalStarSubalgebra.topologicalClosure_minimal
  · apply NonUnitalStarAlgebra.adjoin_le
    rintro _ ⟨⟨x, y⟩, rfl⟩
    exact intervalMatchedRankPair_mem_compactPairAlgebra U x y
  · exact intervalMatchedCompactPairAlgebra_isClosed U

/-- Evaluation of the generated rank-pair algebra in the middle fibre. -/
def intervalMatchedRankPairMiddleOperatorHom : intervalMatchedRankPairAlgebra U →⋆ₙₐ[ℂ]
    AdjointableMap B (HilbertModuleFibre B N (0 : unitInterval))
      (HilbertModuleFibre B N (0 : unitInterval)) :=
  (intervalMatchedRightBoundaryHom (B := B) (M := M) (N := N)).comp
    (NonUnitalStarSubalgebraClass.subtype (intervalMatchedRankPairAlgebra U))

def intervalMatchedRankPairMiddleHom : intervalMatchedRankPairAlgebra U →⋆ₙₐ[ℂ]
    CompactModuleOperator B (HilbertModuleFibre B N (0 : unitInterval)) :=
  NonUnitalStarAlgHom.codRestrict (intervalMatchedRankPairMiddleOperatorHom U)
    (compactModuleOperatorAlgebra (B := B) (E := HilbertModuleFibre B N (0 : unitInterval)))
    (fun T => IsModuleCompact.fibre
      (intervalMatchedRankPairAlgebra_le_compactPairAlgebra U T.property).1.2 0)

/-- Matched vectors lift every actual vector in the middle fibre. -/
theorem intervalMatchedModule_middle_surjective :
    Function.Surjective (fun x : IntervalMatchedModule U =>
      hilbertModuleFibreMk (B := B) (0 : unitInterval) x.val.2) := by
  intro ξ
  obtain ⟨y, rfl⟩ := hilbertModuleFibreMk_surjective (B := B) (M := N) (0 : unitInterval) ξ
  obtain ⟨x, hx⟩ := intervalMatchedModule_snd_surjective U y
  exact ⟨x, congrArg (hilbertModuleFibreMk (B := B) (0 : unitInterval)) hx⟩

/-- The generated rank-pair C⋆-algebra surjects onto the genuine middle
compact algebra by actual matched-vector lifts and closed range. -/
theorem intervalMatchedRankPairMiddleHom_surjective :
    Function.Surjective (intervalMatchedRankPairMiddleHom U) := by
  let φ := intervalMatchedRankPairMiddleOperatorHom U
  let R := (nonUnitalCStarHomCLM φ).range
  have hR : IsClosed (R : Set
      (AdjointableMap B (HilbertModuleFibre B N (0 : unitInterval))
        (HilbertModuleFibre B N (0 : unitInterval)))) := nonUnitalCStarHom_isClosed_range φ
  have hθ (ξ η : HilbertModuleFibre B N (0 : unitInterval)) : moduleRankOne ξ η ∈ R := by
    obtain ⟨x, rfl⟩ := intervalMatchedModule_middle_surjective U ξ
    obtain ⟨y, rfl⟩ := intervalMatchedModule_middle_surjective U η
    refine ⟨⟨intervalMatchedRankPair U x y,
      intervalMatchedRankPair_mem_rankPairAlgebra U x y⟩, ?_⟩
    exact hilbertModuleFibreOperator_rankOne (B := B) 0 x.val.2 y.val.2
  intro T
  obtain ⟨S, hS⟩ := (moduleCompact_le_of_isClosed R hR hθ) T.property
  exact ⟨S, Subtype.ext hS⟩

private theorem rankOne_zero_left {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [SMul C(unitInterval, B)ᵐᵒᵖ E] [CStarModule C(unitInterval, B)ᵐᵒᵖ E] (y : E) :
    moduleRankOne (B := C(unitInterval, B)) (0 : E) y = 0 := by
  ext z
  apply module_inner_ext_left (B := C(unitInterval, B))
  intro w
  rw [moduleRankOne_apply, CStarModule.inner_op_smul_left, CStarModule.inner_zero_left,
    zero_mul, AdjointableMap.coe_zero_apply, CStarModule.inner_zero_left]

/-- An actual first endpoint-null compact lies in the generated pair
algebra, using its proved null rank-one closure. -/
theorem intervalMatchedRankPairAlgebra_mem_left_kernel
    (T : AdjointableMap C(unitInterval, B) M M) (hT : IsModuleCompact T)
    (ht : hilbertModuleFibreOperator (B := B) (1 : unitInterval) T = 0) :
    (T, 0) ∈ intervalMatchedRankPairAlgebra U := by
  let R := (intervalMatchedRankPairAlgebra U).toNonUnitalSubalgebra.toSubmodule
  let S : Submodule ℂ (AdjointableMap C(unitInterval, B) M M) :=
    R.comap (ContinuousLinearMap.inl ℂ
      (AdjointableMap C(unitInterval, B) M M)
      (AdjointableMap C(unitInterval, B) N N)).toLinearMap
  have hS : IsClosed (S : Set (AdjointableMap C(unitInterval, B) M M)) :=
    (intervalMatchedRankPairAlgebra_isClosed U).preimage (ContinuousLinearMap.inl ℂ _ _).continuous
  have hspan : fibreNullFiniteRank (B := B) (M := M) (1 : unitInterval) ≤ S := by
    apply Submodule.span_le.mpr
    rintro _ ⟨x, y, hx, rfl⟩
    obtain ⟨v, hv⟩ := intervalMatchedModule_fst_surjective U y
    let u : IntervalMatchedModule U :=
      ⟨(x, 0), (mem_intervalMatchedSubmodule U (x, 0)).mpr (by rw [hx, U.map_zero, map_zero])⟩
    have hp := intervalMatchedRankPair_mem_rankPairAlgebra U u v
    change (moduleRankOne (B := C(unitInterval, B)) x y, 0) ∈ intervalMatchedRankPairAlgebra U
    simpa only [intervalMatchedRankPair, u, hv, rankOne_zero_left] using hp
  exact (Submodule.topologicalClosure_minimal _ hspan hS)
    ((mem_fibreNullCompact_iff (B := B) (1 : unitInterval) T).mpr ⟨hT, ht⟩)

/-- The corresponding second endpoint-null compact also lies in the actual
generated pair algebra. -/
theorem intervalMatchedRankPairAlgebra_mem_right_kernel
    (T : AdjointableMap C(unitInterval, B) N N) (hT : IsModuleCompact T)
    (ht : hilbertModuleFibreOperator (B := B) (0 : unitInterval) T = 0) :
    (0, T) ∈ intervalMatchedRankPairAlgebra U := by
  let R := (intervalMatchedRankPairAlgebra U).toNonUnitalSubalgebra.toSubmodule
  let S : Submodule ℂ (AdjointableMap C(unitInterval, B) N N) :=
    R.comap (ContinuousLinearMap.inr ℂ
      (AdjointableMap C(unitInterval, B) M M)
      (AdjointableMap C(unitInterval, B) N N)).toLinearMap
  have hS : IsClosed (S : Set (AdjointableMap C(unitInterval, B) N N)) :=
    (intervalMatchedRankPairAlgebra_isClosed U).preimage (ContinuousLinearMap.inr ℂ _ _).continuous
  have hspan : fibreNullFiniteRank (B := B) (M := N) (0 : unitInterval) ≤ S := by
    apply Submodule.span_le.mpr
    rintro _ ⟨x, y, hx, rfl⟩
    obtain ⟨v, hv⟩ := intervalMatchedModule_snd_surjective U y
    let u : IntervalMatchedModule U :=
      ⟨(0, x), (mem_intervalMatchedSubmodule U (0, x)).mpr (by rw [map_zero, U.map_zero, hx])⟩
    have hp := intervalMatchedRankPair_mem_rankPairAlgebra U u v
    change (0, moduleRankOne (B := C(unitInterval, B)) x y) ∈ intervalMatchedRankPairAlgebra U
    simpa only [intervalMatchedRankPair, u, hv, rankOne_zero_left] using hp
  exact (Submodule.topologicalClosure_minimal _ hspan hS)
    ((mem_fibreNullCompact_iff (B := B) (0 : unitInterval) T).mpr ⟨hT, ht⟩)

/-- The full actual compatible compact-pair algebra is generated by rank
ones of matched vectors. This is the compact pullback equality needed for
joining arbitrary interval cycles. -/
theorem intervalMatchedRankPairAlgebra_eq_compactPairAlgebra :
    intervalMatchedRankPairAlgebra U = intervalMatchedCompactPairAlgebra U := by
  apply le_antisymm (intervalMatchedRankPairAlgebra_le_compactPairAlgebra U)
  intro T hT
  let d : CompactModuleOperator B (HilbertModuleFibre B N (0 : unitInterval)) :=
    ⟨hilbertModuleFibreOperator (B := B) (0 : unitInterval) T.2,
      IsModuleCompact.fibre hT.1.2 0⟩
  obtain ⟨S, hS⟩ := intervalMatchedRankPairMiddleHom_surjective U d
  have hS2 : hilbertModuleFibreOperator (B := B) (0 : unitInterval) S.val.2 =
      hilbertModuleFibreOperator (B := B) (0 : unitInterval) T.2 :=
    congrArg Subtype.val hS
  have hSA := intervalMatchedRankPairAlgebra_le_compactPairAlgebra U S.property
  have hTc := hT.2
  change U.transport (hilbertModuleFibreOperator (B := B) (1 : unitInterval) T.1) =
    hilbertModuleFibreOperator (B := B) (0 : unitInterval) T.2 at hTc
  have hSc := hSA.2
  change U.transport (hilbertModuleFibreOperator (B := B) (1 : unitInterval) S.val.1) =
    hilbertModuleFibreOperator (B := B) (0 : unitInterval) S.val.2 at hSc
  have hleft : hilbertModuleFibreOperator (B := B) (1 : unitInterval) (T.1 - S.val.1) = 0 := by
    apply U.transportStarAlgEquiv.injective
    change U.transport (hilbertModuleFibreOperator (B := B) (1 : unitInterval)
      (T.1 - S.val.1)) = U.transport 0
    rw [hilbertModuleFibreOperator_sub, U.transport_sub, hTc, hSc,
      hS2, sub_self, U.transport_zero]
  have hright : hilbertModuleFibreOperator (B := B) (0 : unitInterval) (T.2 - S.val.2) = 0 := by
    rw [hilbertModuleFibreOperator_sub, hS2, sub_self]
  have hL := intervalMatchedRankPairAlgebra_mem_left_kernel U (T.1 - S.val.1)
    (IsModuleCompact.sub hT.1.1 hSA.1.1) hleft
  have hR := intervalMatchedRankPairAlgebra_mem_right_kernel U (T.2 - S.val.2)
    (IsModuleCompact.sub hT.1.2 hSA.1.2) hright
  have hsum := (intervalMatchedRankPairAlgebra U).add_mem S.property
    ((intervalMatchedRankPairAlgebra U).add_mem hL hR)
  have heq : S.val + ((T.1 - S.val.1, 0) + (0, T.2 - S.val.2)) = T := by
    apply Prod.ext <;> simp
  rw [heq] at hsum
  exact hsum

/-- Equality of the two transported endpoint operators gives the exact
intertwining proof used by the actual diagonal adjoint-pair restriction. -/
theorem intervalMatchedCompactPair_compatible
    (T : intervalMatchedCompactPairAlgebra U) :
    IntervalMatchedOperatorCompatible U T.val.1 T.val.2 := by
  intro z
  have hT := T.property.2
  change U.transport (hilbertModuleFibreOperator (B := B) (1 : unitInterval) T.val.1) =
    hilbertModuleFibreOperator (B := B) (0 : unitInterval) T.val.2 at hT
  have h := congrArg (fun S => S (U z)) hT
  simpa only [HilbertModuleEquiv.transport_apply, HilbertModuleEquiv.symm_apply_apply] using h

/-- The full compatible compact-pair algebra acts by genuine adjointable
diagonal restrictions on the matched Hilbert module. -/
def intervalMatchedCompactPairOperatorHom : intervalMatchedCompactPairAlgebra U →⋆ₙₐ[ℂ]
    AdjointableMap C(unitInterval, B) (IntervalMatchedModule U) (IntervalMatchedModule U) where
  toFun T := intervalMatchedOperator U T.val.1 T.val.2 (intervalMatchedCompactPair_compatible U T)
  map_zero' := by
    apply AdjointableMap.ext
    intro x
    apply Subtype.ext
    rfl
  map_add' S T := by
    apply AdjointableMap.ext
    intro x
    apply Subtype.ext
    rfl
  map_mul' S T := by
    apply AdjointableMap.ext
    intro x
    apply Subtype.ext
    rfl
  map_smul' c T := by
    apply AdjointableMap.ext
    intro x
    apply Subtype.ext
    rfl
  map_star' T := by
    apply AdjointableMap.ext
    intro x
    apply Subtype.ext
    rfl

@[simp] theorem intervalMatchedCompactPairOperatorHom_rankPair
    (x y : IntervalMatchedModule U) :
    intervalMatchedCompactPairOperatorHom U
        ⟨intervalMatchedRankPair U x y, intervalMatchedRankPair_mem_compactPairAlgebra U x y⟩ =
      moduleRankOne (B := C(unitInterval, B)) x y := by
  apply AdjointableMap.ext
  intro z
  apply Subtype.ext
  apply Prod.ext
  · change ⟪y.val.1, z.val.1⟫_(C(unitInterval, B)ᵐᵒᵖ) • x.val.1 =
      intervalLeftCoefficient ⟪y, z⟫_(C(unitInterval, B)ᵐᵒᵖ) • x.val.1
    congr 1
    apply MulOpposite.unop_injective
    ext t
    exact (intervalMatchedModule_inner_leftHalf U y z t).symm
  · change ⟪y.val.2, z.val.2⟫_(C(unitInterval, B)ᵐᵒᵖ) • x.val.2 =
      intervalRightCoefficient ⟪y, z⟫_(C(unitInterval, B)ᵐᵒᵖ) • x.val.2
    congr 1
    apply MulOpposite.unop_injective
    ext t
    exact (intervalMatchedModule_inner_rightHalf U y z t).symm

/-- The actual diagonal homomorphism is injective because both component
projections of the matched module are surjective. -/
theorem intervalMatchedCompactPairOperatorHom_injective :
    Function.Injective (intervalMatchedCompactPairOperatorHom U) := by
  intro S T h
  apply Subtype.ext
  apply Prod.ext
  · ext x
    obtain ⟨z, rfl⟩ := intervalMatchedModule_fst_surjective U x
    exact congrArg (fun R => (R z).val.1) h
  · ext y
    obtain ⟨z, rfl⟩ := intervalMatchedModule_snd_surjective U y
    exact congrArg (fun R => (R z).val.2) h

/-- The diagonal compact-pair homomorphism has exactly the genuine product
operator norm, by the proved injectivity of this actual C⋆-homomorphism. -/
theorem intervalMatchedCompactPairOperatorHom_norm
    (T : intervalMatchedCompactPairAlgebra U) :
    ‖intervalMatchedCompactPairOperatorHom U T‖ = max ‖T.val.1‖ ‖T.val.2‖ :=
  NonUnitalStarAlgHom.norm_map (intervalMatchedCompactPairOperatorHom U)
    (intervalMatchedCompactPairOperatorHom_injective U) T

/-- Every compatible diagonal restriction is bounded by the actual maximum
of its component operator norms, with no compactness hypothesis. -/
theorem intervalMatchedOperator_norm_le_max
    (T : AdjointableMap C(unitInterval, B) M M)
    (S : AdjointableMap C(unitInterval, B) N N)
    (h : IntervalMatchedOperatorCompatible U T S) :
    ‖intervalMatchedOperator U T S h‖ ≤ max ‖T‖ ‖S‖ := by
  apply ContinuousLinearMap.opNorm_le_bound _
    ((norm_nonneg T).trans (le_max_left _ _))
  intro x
  rw [intervalMatchedModule_norm]
  apply max_le
  · calc
      ‖T x.val.1‖ ≤ ‖T‖ * ‖x.val.1‖ := T.norm_apply_le _
      _ ≤ max ‖T‖ ‖S‖ * max ‖x.val.1‖ ‖x.val.2‖ :=
        mul_le_mul (le_max_left _ _) (le_max_left _ _) (norm_nonneg _)
          ((norm_nonneg T).trans (le_max_left _ _))
      _ = max ‖T‖ ‖S‖ * ‖x‖ := rfl
  · calc
      ‖S x.val.2‖ ≤ ‖S‖ * ‖x.val.2‖ := S.norm_apply_le _
      _ ≤ max ‖T‖ ‖S‖ * max ‖x.val.1‖ ‖x.val.2‖ :=
        mul_le_mul (le_max_right _ _) (le_max_right _ _) (norm_nonneg _)
          ((norm_nonneg T).trans (le_max_left _ _))
      _ = max ‖T‖ ‖S‖ * ‖x‖ := rfl

/-- Pairs whose genuine diagonal is compact form an actual closed
star-subalgebra of the already constructed compatible compact-pair algebra. -/
def intervalMatchedCompactDiagonalAlgebra : NonUnitalStarSubalgebra ℂ
    (intervalMatchedCompactPairAlgebra U) :=
  NonUnitalStarSubalgebra.comap (intervalMatchedCompactPairOperatorHom U)
    (compactModuleOperatorAlgebra (B := C(unitInterval, B)) (E := IntervalMatchedModule U))

instance intervalMatchedCompactDiagonalAlgebra_isClosed :
    IsClosed (intervalMatchedCompactDiagonalAlgebra U : Set (intervalMatchedCompactPairAlgebra U)) :=
  (moduleCompact_isClosed (B := C(unitInterval, B))
    (E := IntervalMatchedModule U) (F := IntervalMatchedModule U)).preimage
      (nonUnitalCStarHomCLM (intervalMatchedCompactPairOperatorHom U)).continuous

instance intervalMatchedCompactDiagonalAlgebra_nonUnitalCStarAlgebra :
    NonUnitalCStarAlgebra (intervalMatchedCompactDiagonalAlgebra U) :=
  NonUnitalStarSubalgebra.nonUnitalCStarAlgebra _

/-- Every compatible compact pair has a compact diagonal on the actual
matching module. The closed C⋆-range of the compact-diagonal subalgebra
contains all matched rank pairs, hence the full generated pair algebra. -/
theorem intervalMatchedCompactPairOperatorHom_isModuleCompact
    (T : intervalMatchedCompactPairAlgebra U) :
    IsModuleCompact (intervalMatchedCompactPairOperatorHom U T) := by
  let φ := (NonUnitalStarSubalgebraClass.subtype (intervalMatchedCompactPairAlgebra U)).comp
    (NonUnitalStarSubalgebraClass.subtype (intervalMatchedCompactDiagonalAlgebra U))
  have hclosed : IsClosed (NonUnitalStarAlgHom.range φ : Set
      (AdjointableMap C(unitInterval, B) M M × AdjointableMap C(unitInterval, B) N N)) :=
    nonUnitalCStarHom_isClosed_range φ
  have hgen : intervalMatchedRankPairAlgebra U ≤ NonUnitalStarAlgHom.range φ := by
    apply NonUnitalStarSubalgebra.topologicalClosure_minimal
    · apply NonUnitalStarAlgebra.adjoin_le
      rintro _ ⟨⟨x, y⟩, rfl⟩
      let p : intervalMatchedCompactPairAlgebra U :=
        ⟨intervalMatchedRankPair U x y, intervalMatchedRankPair_mem_compactPairAlgebra U x y⟩
      have hp : p ∈ intervalMatchedCompactDiagonalAlgebra U := by
        change IsModuleCompact (intervalMatchedCompactPairOperatorHom U p)
        rw [intervalMatchedCompactPairOperatorHom_rankPair]
        exact moduleRankOne_mem_moduleCompact x y
      exact ⟨⟨p, hp⟩, rfl⟩
    · exact hclosed
  have hT : T.val ∈ NonUnitalStarAlgHom.range φ :=
    hgen ((intervalMatchedRankPairAlgebra_eq_compactPairAlgebra U).symm ▸ T.property)
  obtain ⟨S, hS⟩ := hT
  have heq : S.val = T := Subtype.ext hS
  exact heq ▸ S.property

/-- The diagonal restriction of any compatible compact component operators
is genuinely compact on the glued Hilbert module. -/
theorem intervalMatchedOperator_isModuleCompact
    (T : AdjointableMap C(unitInterval, B) M M)
    (S : AdjointableMap C(unitInterval, B) N N)
    (h : IntervalMatchedOperatorCompatible U T S)
    (hT : IsModuleCompact T) (hS : IsModuleCompact S) :
    IsModuleCompact (intervalMatchedOperator U T S h) := by
  have heq : U.transport (hilbertModuleFibreOperator (B := B) (1 : unitInterval) T) =
      hilbertModuleFibreOperator (B := B) (0 : unitInterval) S := by
    ext z
    rw [HilbertModuleEquiv.transport_apply, h, U.apply_symm_apply]
  have hp := intervalMatchedCompactPairOperatorHom_isModuleCompact U
    ⟨(T, S), ⟨⟨hT, hS⟩, heq⟩⟩
  exact hp

/-- The complete compatible compact-pair C⋆-algebra maps into the actual
compact C⋆-algebra of the matched module. -/
def intervalMatchedCompactPairHom : intervalMatchedCompactPairAlgebra U →⋆ₙₐ[ℂ]
    CompactModuleOperator C(unitInterval, B) (IntervalMatchedModule U) :=
  NonUnitalStarAlgHom.codRestrict (intervalMatchedCompactPairOperatorHom U)
    (compactModuleOperatorAlgebra (B := C(unitInterval, B)) (E := IntervalMatchedModule U))
    (intervalMatchedCompactPairOperatorHom_isModuleCompact U)

/-- Every glued compact operator comes from a compatible compact pair,
because the genuine closed diagonal range contains every glued rank one. -/
theorem intervalMatchedCompactPairHom_surjective :
    Function.Surjective (intervalMatchedCompactPairHom U) := by
  let φ := intervalMatchedCompactPairOperatorHom U
  let R := (nonUnitalCStarHomCLM φ).range
  have hR : IsClosed (R : Set
      (AdjointableMap C(unitInterval, B) (IntervalMatchedModule U) (IntervalMatchedModule U))) :=
    nonUnitalCStarHom_isClosed_range φ
  have hθ (x y : IntervalMatchedModule U) : moduleRankOne x y ∈ R :=
    ⟨⟨intervalMatchedRankPair U x y, intervalMatchedRankPair_mem_compactPairAlgebra U x y⟩,
      intervalMatchedCompactPairOperatorHom_rankPair U x y⟩
  intro T
  obtain ⟨S, hS⟩ := (moduleCompact_le_of_isClosed R hR hθ) T.property
  exact ⟨S, Subtype.ext hS⟩

/-- The actual compact-operator algebra of the matched module is the full
endpoint pullback of the original compact-operator algebras. -/
def intervalMatchedCompactPairEquiv : intervalMatchedCompactPairAlgebra U ≃⋆ₐ[ℂ]
    CompactModuleOperator C(unitInterval, B) (IntervalMatchedModule U) :=
  StarAlgEquiv.ofBijective (intervalMatchedCompactPairHom U)
    ⟨fun _S _T h => intervalMatchedCompactPairOperatorHom_injective U (congrArg Subtype.val h),
      intervalMatchedCompactPairHom_surjective U⟩

end BC4lean.KKTheory
